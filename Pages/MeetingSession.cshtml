@page
@model MeetingSessionModel
@using System.Text.Json
@using TL.Models
@{
    ViewData["Title"] = "Team Meeting";
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    string J(object o) => System.Text.Json.JsonSerializer.Serialize(o, jsonOpts);
}

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Team Meeting</div>
            <div class="page-sub">RITTAL-CSM Ltd, Plymouth &bull; Invitation for Team Meeting &bull; doc CI038/01/1123/CW</div>
        </div>
        <a asp-page="/MeetingRota" class="sbtn sm">&larr; Meeting Rota</a>
    </div>

    @if (Model.SlotMissing)
    {
        <div class="card" style="padding:16px 18px">
            <div class="empty">No meeting slot selected. Open a slot from the Meeting Rota &ldquo;This week&rdquo; panel.</div>
        </div>
        return;
    }

    @if (!Model.CanEdit)
    {
        <div class="card" style="margin-bottom:14px;padding:12px 16px;background:#fffbeb;border-color:#fde68a;color:#92400e;font-size:13px">
            You can view this meeting but only Head of Department / Shift Manager users can record or edit it.
        </div>
    }

    <form method="post" id="mtg-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="meetingDate" value="@Model.MeetingDate" />
        <input type="hidden" name="area" value="@Model.Area" />
        <input type="hidden" name="shift" value="@Model.Shift" />
        @if (Model.EditingId.HasValue)
        {
            <input type="hidden" name="editingId" value="@Model.EditingId" />
        }
        <input type="hidden" name="ProblemsJson" id="ProblemsJson" />
        <input type="hidden" name="TeamMembersJson" id="TeamMembersJson" />
        <input type="hidden" name="GroupMembersJson" id="GroupMembersJson" />
        <input type="hidden" name="GuestsJson" id="GuestsJson" />

        <fieldset style="border:0;padding:0;margin:0" @(Model.CanEdit ? "" : "disabled")>

            <!-- Header -->
            <div class="card" style="margin-bottom:14px">
                <div class="card-head">
                    <span class="card-title">Meeting session</span>
                    <span class="card-sub">@Model.Area &bull; @Model.Shift @(string.IsNullOrEmpty(Model.ShiftTime) ? "" : "(" + Model.ShiftTime + ")") &bull; @Model.MeetingDate</span>
                </div>
                <div style="padding:14px 18px">
                    <div class="sf-row" style="margin-bottom:12px">
                        <div class="fl"><label>Supervisor</label><input type="text" name="Supervisor" value="@Model.Supervisor"></div>
                        <div class="fl"><label>Cost Centre</label><input type="text" name="CostCentre" value="@Model.CostCentre"></div>
                    </div>
                    <div class="sf-row" style="margin-bottom:12px">
                        <div class="fl"><label>Team / Area</label><input type="text" name="Team" value="@Model.Team"></div>
                        <div class="fl"><label>Location</label><input type="text" name="Location" value="@Model.Location"></div>
                    </div>
                    <div class="sf-row">
                        <div class="fl"><label>Compiled on</label><input type="date" name="CompiledOn" value="@Model.CompiledOn"></div>
                        <div class="fl"><label>Date / Time</label><input type="text" name="MeetingDateTime" value="@Model.MeetingDateTime"></div>
                    </div>
                </div>
            </div>

            <!-- Content sections -->
            <div class="card" style="margin-bottom:14px">
                <div class="card-head"><span class="card-title">Meeting content</span></div>
                <div style="padding:14px 18px;display:flex;flex-direction:column;gap:12px">
                    <div class="fl" style="margin:0"><label>Actions</label><textarea name="Actions" rows="2">@Model.Actions</textarea></div>
                    <div class="fl" style="margin:0"><label>H&amp;S <span style="font-weight:400;color:var(--muted)">— prevention: safe starts, hazards &amp; near misses, pre-task risk assessment</span></label><textarea name="HealthSafety" rows="2">@Model.HealthSafety</textarea></div>
                    <div class="fl" style="margin:0"><label>Customer Satisfaction</label><textarea name="CustomerSatisfaction" rows="2">@Model.CustomerSatisfaction</textarea></div>
                    <div class="fl" style="margin:0"><label>KPIs</label><textarea name="Kpis" rows="2">@Model.Kpis</textarea></div>
                    <div class="fl" style="margin:0"><label>Employee Satisfaction <span style="font-weight:400;color:var(--muted)">— 1-to-1s &amp; team meetings, new engineers</span></label><textarea name="EmployeeSatisfaction" rows="2">@Model.EmployeeSatisfaction</textarea></div>
                    <div class="fl" style="margin:0"><label>AOB</label><textarea name="Aob" rows="2">@Model.Aob</textarea></div>
                </div>
            </div>

            <!-- Results -->
            <div class="card" style="margin-bottom:14px">
                <div class="card-head"><span class="card-title">Meeting results</span></div>
                <div style="padding:14px 18px;display:flex;flex-direction:column;gap:12px">
                    <div class="fl" style="margin:0"><label>Results</label><textarea name="MeetingResults" rows="3">@Model.MeetingResults</textarea></div>
                    <div class="fl" style="margin:0;max-width:320px"><label>Minutes keeper</label><input type="text" name="MinutesKeeper" value="@Model.MinutesKeeper"></div>
                </div>
            </div>

            <!-- Top 3 problems -->
            <div class="card" style="margin-bottom:14px">
                <div class="card-head">
                    <span class="card-title">Top 3 problems</span>
                    <span class="card-sub">Status 0 &rarr; 4 (identified &rarr; standardised)</span>
                </div>
                <div style="overflow-x:auto">
                    <table class="dash-table" style="min-width:820px">
                        <thead>
                            <tr><th>Problem</th><th>Action</th><th>Responsible</th><th>Finish date</th><th>Status</th></tr>
                        </thead>
                        <tbody id="prob-body">
                            @for (var i = 0; i < 3; i++)
                            {
                                var p = i < Model.Problems.Count ? Model.Problems[i] : new TeamMeetingProblem();
                                <tr class="prob-row">
                                    <td><input type="text" class="p-problem" value="@p.Problem" style="width:100%"></td>
                                    <td><input type="text" class="p-action" value="@p.Action" style="width:100%"></td>
                                    <td><input type="text" class="p-resp" value="@p.Responsible" style="width:100%"></td>
                                    <td><input type="date" class="p-finish" value="@(p.FinishDate?.ToString("yyyy-MM-dd"))"></td>
                                    <td>
                                        <select class="p-status">
                                            @foreach (var s in TeamMeetingStatus.All)
                                            {
                                                <option value="@s.Value" selected="@(p.Status == s.Value ? "selected" : null)">@s.Label</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Attendance -->
            <div class="card">
                <div class="card-head"><span class="card-title">Attendance</span></div>
                <div style="padding:14px 18px;display:flex;flex-direction:column;gap:16px">
                    <div>
                        <div style="font-weight:600;margin-bottom:6px">Team members</div>
                        <div id="team-rows"></div>
                        <button type="button" class="sbtn sm add-row" data-target="team-rows" data-kind="present">+ Add team member</button>
                    </div>
                    <div>
                        <div style="font-weight:600;margin-bottom:6px">Group members</div>
                        <div id="group-rows"></div>
                        <button type="button" class="sbtn sm add-row" data-target="group-rows" data-kind="present">+ Add group member</button>
                    </div>
                    <div>
                        <div style="font-weight:600;margin-bottom:6px">Guests</div>
                        <div id="guest-rows"></div>
                        <button type="button" class="sbtn sm add-row" data-target="guest-rows" data-kind="guest">+ Add guest</button>
                    </div>
                    <div style="font-size:11px;color:var(--muted);font-style:italic">
                        Absent team members are to be informed at the next attendance and are to sign and place the date in the &ldquo;present&rdquo; column.
                    </div>
                </div>
            </div>
        </fieldset>

        @if (Model.CanEdit)
        {
            <div style="margin-top:16px;display:flex;align-items:center;gap:12px">
                <button type="submit" class="sbtn primary">Save meeting</button>
                <a asp-page="/MeetingRota" class="sbtn">Cancel</a>
            </div>
        }
    </form>
</div>

<script>
(function () {
    'use strict';
    var canEdit = @(Model.CanEdit ? "true" : "false");
    var initTeam = @Html.Raw(J(Model.TeamMembers));
    var initGroup = @Html.Raw(J(Model.GroupMembers));
    var initGuests = @Html.Raw(J(Model.Guests));

    function esc(s) { return (s == null ? '' : String(s)).replace(/"/g, '&quot;'); }

    function presentRow(a) {
        a = a || {};
        return '<div class="attend-row" style="display:flex;gap:8px;align-items:center;margin-bottom:6px">' +
            '<input type="text" class="a-name" placeholder="Name" value="' + esc(a.name) + '" style="flex:1;min-width:160px">' +
            '<label style="display:flex;align-items:center;gap:5px;font-size:12px;white-space:nowrap">' +
            '<input type="checkbox" class="a-present"' + (a.present ? ' checked' : '') + '> Present</label>' +
            '<button type="button" class="sbtn sm del-row" title="Remove">&times;</button></div>';
    }
    function guestRow(g) {
        g = g || {};
        return '<div class="attend-row" style="display:flex;gap:8px;align-items:center;margin-bottom:6px">' +
            '<input type="text" class="g-name" placeholder="Name" value="' + esc(g.name) + '" style="flex:1;min-width:130px">' +
            '<input type="text" class="g-dept" placeholder="Department" value="' + esc(g.department) + '" style="flex:1;min-width:130px">' +
            '<input type="text" class="g-tel" placeholder="Telephone" value="' + esc(g.telephone) + '" style="flex:1;min-width:120px">' +
            '<button type="button" class="sbtn sm del-row" title="Remove">&times;</button></div>';
    }

    function fill(id, list, kind) {
        var host = document.getElementById(id);
        var html = (list || []).map(kind === 'guest' ? guestRow : presentRow).join('');
        // Always leave at least one empty row to type into (when editable).
        if (canEdit && (!list || list.length === 0)) html = (kind === 'guest' ? guestRow({}) : presentRow({}));
        host.innerHTML = html;
    }
    fill('team-rows', initTeam, 'present');
    fill('group-rows', initGroup, 'present');
    fill('guest-rows', initGuests, 'guest');

    document.addEventListener('click', function (e) {
        var add = e.target.closest('.add-row');
        if (add && canEdit) {
            var host = document.getElementById(add.dataset.target);
            host.insertAdjacentHTML('beforeend', add.dataset.kind === 'guest' ? guestRow({}) : presentRow({}));
            return;
        }
        var del = e.target.closest('.del-row');
        if (del && canEdit) { del.closest('.attend-row').remove(); }
    });

    var form = document.getElementById('mtg-form');
    if (form && canEdit) {
        form.addEventListener('submit', function () {
            var problems = [];
            document.querySelectorAll('#prob-body .prob-row').forEach(function (r) {
                var problem = r.querySelector('.p-problem').value.trim();
                var action = r.querySelector('.p-action').value.trim();
                var resp = r.querySelector('.p-resp').value.trim();
                if (!problem && !action && !resp) return;
                problems.push({
                    problem: problem, action: action, responsible: resp,
                    finishDate: r.querySelector('.p-finish').value || null,
                    status: parseInt(r.querySelector('.p-status').value, 10) || 0
                });
            });
            document.getElementById('ProblemsJson').value = JSON.stringify(problems);

            function collectPresent(id) {
                var out = [];
                document.querySelectorAll('#' + id + ' .attend-row').forEach(function (r) {
                    var name = r.querySelector('.a-name').value.trim();
                    if (!name) return;
                    out.push({ name: name, present: r.querySelector('.a-present').checked });
                });
                return out;
            }
            document.getElementById('TeamMembersJson').value = JSON.stringify(collectPresent('team-rows'));
            document.getElementById('GroupMembersJson').value = JSON.stringify(collectPresent('group-rows'));

            var guests = [];
            document.querySelectorAll('#guest-rows .attend-row').forEach(function (r) {
                var name = r.querySelector('.g-name').value.trim();
                var dept = r.querySelector('.g-dept').value.trim();
                if (!name && !dept) return;
                guests.push({ name: name, department: dept, telephone: r.querySelector('.g-tel').value.trim() });
            });
            document.getElementById('GuestsJson').value = JSON.stringify(guests);
        });
    }
})();
</script>
