@page
@model AuditHistoryModel
@using TL.Models
@{ ViewData["Title"] = "Audit history"; }

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Audit History</div>
            <div class="page-sub">Senior management walkaround records</div>
        </div>
        <a asp-page="/AuditStart" class="sbtn primary sm">+ New audit</a>
    </div>

    <div class="card" style="margin-bottom:14px">
        <form method="get" class="filters">
            <div class="sf"><label>From</label><input type="date" name="from" value="@Model.From"></div>
            <div class="sf"><label>To</label><input type="date" name="to" value="@Model.To"></div>
            <div class="sf">
                <label>Area</label>
                <select name="area" style="max-width:200px">
                    <option value="">All areas</option>
                    @foreach (var grp in AreaList.All.GroupBy(a => a.Group))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var a in grp)
                            {
                                <option value="@a.Label" selected="@(Model.AreaFilter == a.Label)">@a.Label</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="sf"><label>Auditor</label><input type="text" name="auditor" value="@Model.AuditorFilter" placeholder="Search name…" style="min-width:140px"></div>
            <button type="submit" class="sbtn sm">Filter</button>
            <a asp-page="/AuditHistory" class="sbtn sm">Clear</a>
        </form>
    </div>

    <div class="card">
        <div class="card-head">
            <span class="card-title">Audits</span>
            <span class="card-sub">@Model.Audits.Count record@(Model.Audits.Count == 1 ? "" : "s")</span>
        </div>
        @if (!Model.Audits.Any())
        {
            <div class="empty">No audits found for the selected filters.</div>
        }
        else
        {
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
                <table class="dash-table" style="min-width:700px">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Area</th>
                            <th>Auditor</th>
                            <th>TL observed</th>
                            <th>Shift</th>
                            <th>Safety</th>
                            <th>Quality</th>
                            <th>Perf</th>
                            <th>Actions?</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Audits)
                        {
                            <tr>
                                <td>@a.AuditDate.ToString("dd/MM/yyyy")</td>
                                <td style="font-weight:600">@a.Area</td>
                                <td>@a.AuditorName</td>
                                <td>@(a.TLOnShift ?? "—")</td>
                                <td>@(a.ShiftObserved ?? "—")</td>
                                <td><span class="rag @AuditHistoryModel.Rc(a.OverallSafetyStatus)">@(a.OverallSafetyStatus ?? "—")</span></td>
                                <td><span class="rag @AuditHistoryModel.Rc(a.OverallQualityStatus)">@(a.OverallQualityStatus ?? "—")</span></td>
                                <td><span class="rag @AuditHistoryModel.Rc(a.OverallPerfStatus)">@(a.OverallPerfStatus ?? "—")</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(a.ActionsRaised))
                                    {
                                        <span style="color:#b45309;font-weight:600;font-size:11px">&#9888; Yes</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--muted);font-size:11px">—</span>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    <a asp-page="/Audit" asp-route-id="@a.Id" class="dl-link">Edit</a>
                                    &nbsp;
                                    <a href="/api/audits/@a.Id/pdf" class="dl-link">PDF</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
