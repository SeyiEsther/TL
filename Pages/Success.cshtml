@page
@model SuccessModel
@{ ViewData["Title"] = Model.NotFoundRecord ? "Not found" : "Submitted"; }

<div class="success-wrap">
    <div class="success-card">
        @if (Model.NotFoundRecord)
        {
            <div class="success-title">Record not found</div>
            <div class="success-sub">This submission may have been deleted, or the link is incomplete.</div>
            <div class="success-ref">Ref #@Model.SubmissionId</div>
            @if (Model.IsHodDailyAudit)
            {
                <a asp-page="/History" asp-route-tab="hod" class="welcome-btn primary">Audit history</a>
                <a asp-page="/HodDashboard" class="welcome-btn secondary">HoD dashboard</a>
            }
            else
            {
                <a asp-page="/Index" class="welcome-btn primary">Back to home</a>
            }
        }
        else if (Model.IsMeeting)
        {
            <div class="success-icon">&#10003;</div>
            <div class="success-title">Team meeting saved</div>
            <div class="success-sub">Saved successfully.</div>
            <div class="success-ref">Ref #@Model.SubmissionId</div>
            <a asp-page="/MeetingSession" asp-route-id="@Model.SubmissionId" class="welcome-btn primary">View / edit meeting</a>
            <a href="/api/meetings/@Model.SubmissionId/pdf" class="welcome-btn secondary pdf-dl" data-filename="TeamMeeting.pdf">&#8595; Download PDF</a>
            <a asp-page="/MeetingRota" class="welcome-btn secondary">Back to Meeting Rota</a>
        }
        else if (Model.IsProgressSave)
        {
            <div class="success-icon">&#10003;</div>
            <div class="success-title">Progress saved</div>
            <div class="success-sub">Your changes are saved. You can keep going now or come back to it later — nothing is lost.</div>
            <div class="success-ref">Ref #@Model.SubmissionId</div>
            @if (Model.IsHodDailyAudit)
            {
                <a asp-page="/Audit" asp-route-id="@Model.SubmissionId" class="welcome-btn primary">Continue editing</a>
                <a asp-page="/HodDashboard" class="welcome-btn secondary">HoD dashboard</a>
            }
            else
            {
                <a asp-page="/Form" asp-route-id="@Model.SubmissionId" class="welcome-btn primary">Continue editing</a>
                <a asp-page="/Index" class="welcome-btn secondary">Back to home</a>
            }
        }
        else
        {
            <div class="success-icon">&#10003;</div>
            @if (Model.IsHodDailyAudit)
            {
                <div class="success-title">@(Model.HodAuditTypeLabel ?? "HoD audit") submitted!</div>
            }
            else
            {
                <div class="success-title">@(Model.IsAudit ? "Head of Department / Shift Manager audit submitted!" : "Shift submitted!")</div>
            }
            <div class="success-sub">Saved successfully.</div>
            <div class="success-ref">Ref #@Model.SubmissionId</div>
            @if (Model.IsHodDailyAudit)
            {
                <a asp-page="/AuditResult" asp-route-id="@Model.SubmissionId" asp-route-kind="hod" class="welcome-btn primary">View result</a>
                <a asp-page="/Audit" asp-route-id="@Model.SubmissionId" class="welcome-btn secondary">Edit audit</a>
                <a href="/api/audits/hod/@Model.SubmissionId/pdf" class="welcome-btn secondary pdf-dl" data-filename="HoD_Audit.pdf">&#8595; Download PDF</a>
                <a asp-page="/HodDashboard" class="welcome-btn secondary">HoD dashboard</a>
                <a asp-page="/AuditStart" class="welcome-btn secondary">New audit</a>
                <a asp-page="/History" asp-route-tab="hod" class="welcome-btn secondary">Audit history</a>
            }
            else if (Model.IsAudit)
            {
                <a asp-page="/AuditResult" asp-route-id="@Model.SubmissionId" asp-route-kind="legacy" class="welcome-btn primary">View result</a>
                <a asp-page="/AuditStart" class="welcome-btn secondary">New audit</a>
                <a asp-page="/History" asp-route-tab="hod" class="welcome-btn secondary">Audit history</a>
            }
            else
            {
                <a asp-page="/Index" class="welcome-btn primary">Back to home</a>
                <a href="/api/submissions/@Model.SubmissionId/pdf" class="welcome-btn secondary pdf-dl" data-filename="TLSW_Submission.pdf">&#8595; Download PDF</a>
            }
        }
    </div>
</div>
