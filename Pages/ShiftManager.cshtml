@page
@{
    ViewData["Title"] = "Shift Manager";
}

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Shift Manager</div>
            <div class="page-sub">Daily report and the audits shift managers carry out</div>
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="card-head"><span class="card-title">Daily report</span></div>
        <div style="padding:16px 18px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <a asp-page="/ShiftManagerReport" class="sbtn primary sm">＋ New daily report</a>
            <a asp-page="/ShiftManagerHistory" class="sbtn sm">Report history</a>
            <span style="font-size:12px;color:var(--muted)">HSE, production and audit summary for the shift.</span>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><span class="card-title">Audits</span><span class="card-sub">Shift managers still perform the daily audits</span></div>
        <div style="padding:16px 18px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <a asp-page="/AuditStart" asp-route-from="sm" class="sbtn primary sm">Start an audit</a>
            <a asp-page="/History" asp-route-tab="hod" class="sbtn sm">Audit history</a>
            <span style="font-size:12px;color:var(--muted)">Uses the same audit forms as HOD (6S, TPM, Parts ID, Quality).</span>
        </div>
    </div>
</div>
