@page
@model ShiftHistoryModel
@{ ViewData["Title"] = "Shifts & follow-up"; }

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Shifts & follow-up</div>
            <div class="page-sub">Follow-up cards above · full shift list below</div>
        </div>
        <a asp-page="/History" class="sbtn sm">History</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="card" style="margin-bottom:14px;padding:12px 16px;font-size:13px;color:#16a34a;background:#f0fdf4;border-color:#bbf7d0">
            @Model.StatusMessage
        </div>
    }

    <div class="card card-filter" style="margin-bottom:14px">
        <form method="get" class="filters">
            <partial name="_DatePicker" model='new DatePickerModel("from", Model.From, "From")' />
            <partial name="_DatePicker" model='new DatePickerModel("to", Model.To, "To")' />
            <partial name="_FilterShift" model='new FilterDropdownModel("shift", "Shift", Model.ShiftFilter, "All shifts")' />
            <partial name="_FilterArea" model='new FilterDropdownModel("area", "Area", Model.AreaFilter, "All areas")' />
            <div class="ff">
                <span class="ff-label">Team leader</span>
                <div class="ff-control">
                    <svg class="ff-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" name="q" class="ff-input" value="@Model.PersonFilter" placeholder="Search name…" style="min-width:180px">
                </div>
            </div>
            <div class="filter-actions">
                <button type="submit" class="sbtn sm filter-apply">Apply filters</button>
                <a asp-page="/ShiftHistory" class="sbtn sm">Clear</a>
            </div>
        </form>
    </div>

    <partial name="_ShiftHistoryHub" model="Model" />
</div>
