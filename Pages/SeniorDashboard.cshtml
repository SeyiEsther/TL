@page
@model SeniorDashboardModel
@using TL.Models
@using TL.Services
@{ ViewData["Title"] = "Senior Dashboard"; }

<div class="dwrap">

    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Senior Team Dashboard</div>
            <div class="page-sub">@Model.TotalAudits audit@(Model.TotalAudits == 1 ? "" : "s") in view</div>
        </div>
        <a asp-page="/SeniorStart" class="sbtn primary sm">+ New audit</a>
    </div>

    <div class="card card-filter" style="margin-bottom:14px">
        <form method="get" class="filters">
            <partial name="_DatePicker" model='new DatePickerModel("from", Model.From, "From")' />
            <partial name="_DatePicker" model='new DatePickerModel("to", Model.To, "To")' />
            <partial name="_FilterArea" model='new FilterDropdownModel("area", "Area", Model.AreaFilter, "All areas")' />
            <div class="filter-actions">
                <button type="submit" class="sbtn sm filter-apply">Apply filters</button>
                <a asp-page="/SeniorDashboard" class="sbtn sm">Clear</a>
            </div>
        </form>
    </div>

    <div class="sd-tab-bar card" style="margin-bottom:14px;padding:8px 12px">
        <button type="button" class="sd-tab active" data-tab="overview">Overview</button>
        <button type="button" class="sd-tab" data-tab="leadership">Leadership</button>
        <button type="button" class="sd-tab" data-tab="safety">Safety</button>
        <button type="button" class="sd-tab" data-tab="quality">Quality</button>
        <button type="button" class="sd-tab" data-tab="people">People</button>
        <button type="button" class="sd-tab" data-tab="standards">Standards</button>
        <button type="button" class="sd-tab" data-tab="performance">Performance</button>
        <button type="button" class="sd-tab" data-tab="records">Records</button>
    </div>

    @if (Model.TotalAudits == 0)
    {
        <div class="card">
            <div class="empty">No senior audits in this period.</div>
            <div style="text-align:center;padding-bottom:24px">
                <a asp-page="/SeniorStart" class="sbtn primary">Start first audit</a>
            </div>
        </div>
    }
    else
    {
        <!-- OVERVIEW -->
        <div class="sd-panel active" id="panel-overview">
            <div class="kpi-row" style="margin-bottom:14px">
                <div class="kpi kpi-blue">
                    <div class="kpi-icon-wrap kpi-icon-blue">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    </div>
                    <div class="kpi-label">Overall score</div>
                    <div class="kpi-val" style="color:@SeniorDashboardModel.GaugeColor(Model.AvgScore)">@Model.AvgScore%</div>
                    <div class="kpi-sub">Average compliance</div>
                </div>
                <div class="kpi kpi-green">
                    <div class="kpi-icon-wrap kpi-icon-green">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                    </div>
                    <div class="kpi-label">Green verdicts</div>
                    <div class="kpi-val" style="color:#16a34a">@Model.VerdictGreen</div>
                    <div class="kpi-sub">Audits</div>
                </div>
                <div class="kpi kpi-amber">
                    <div class="kpi-icon-wrap kpi-icon-amber">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                    </div>
                    <div class="kpi-label">Amber verdicts</div>
                    <div class="kpi-val" style="color:#b45309">@Model.VerdictAmber</div>
                    <div class="kpi-sub">Audits</div>
                </div>
                <div class="kpi kpi-indigo">
                    <div class="kpi-icon-wrap kpi-icon-indigo">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                    </div>
                    <div class="kpi-label">Red verdicts</div>
                    <div class="kpi-val" style="color:#CC1F2C">@Model.VerdictRed</div>
                    <div class="kpi-sub">Audits</div>
                </div>
            </div>

            @if (Model.Latest != null)
            {
                <div class="card" style="margin-bottom:14px">
                    <div class="card-head">
                        <span class="card-title">Latest audit</span>
                        <span class="card-sub">@Model.Latest.AuditDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="meta-row">
                        <div class="meta-item"><span class="meta-label">Area</span><span class="meta-val">@Model.Latest.Area</span></div>
                        <div class="meta-item"><span class="meta-label">Auditor</span><span class="meta-val">@Model.Latest.AuditorName</span></div>
                        @if (!string.IsNullOrEmpty(Model.Latest.OverallVerdict))
                        {
                            <div class="meta-item"><span class="meta-label">Verdict</span><span class="rv @SeniorDashboardModel.Rc(Model.Latest.OverallVerdict)">@Model.Latest.OverallVerdict</span></div>
                        }
                    </div>
                </div>
            }

            <div class="chart-grid-4" style="margin-bottom:14px">
                @{ RenderGaugeCard(Model.GovScore, "Governance"); }
                @{ RenderGaugeCard(Model.SafetyScore, "Safety"); }
                @{ RenderGaugeCard(Model.QualityScore, "Quality"); }
                @{ RenderGaugeCard(Model.PeopleScore, "People"); }
                @{ RenderGaugeCard(Model.StandardsScore, "Standards"); }
                @{ RenderGaugeCard(Model.PerfScore, "Performance"); }
            </div>
        </div>

        RenderCategoryPanel("leadership", "Leadership & Governance", Model.GovScore,
            ("Handover standards", a => a.HandoverStandardsFollowed),
            ("Visual management", a => a.VisualManagementCurrent),
            ("Escalation paths", a => a.EscalationPathsUsed));

        RenderCategoryPanel("safety", "Safety Culture", Model.SafetyScore,
            ("PPE compliance", a => a.PpeComplianceFull),
            ("Near-misses reported", a => a.NearMissesReported),
            ("Safety action log", a => a.SafetyActionLogCurrent));

        RenderCategoryPanel("quality", "Quality Governance", Model.QualityScore,
            ("First-off records", a => a.FirstOffRecordsComplete),
            ("NC capture trended", a => a.NcCaptureTrended),
            ("Quality gates", a => a.QualityGatesMaintained));

        RenderCategoryPanel("people", "People & Wellbeing", Model.PeopleScore,
            ("Absence managed", a => a.AbsenceManagedProactively),
            ("TLs coaching", a => a.TlsCoachingTeams),
            ("Training matrix", a => a.TrainingMatrixCurrent));

        RenderCategoryPanel("standards", "Standards & Housekeeping", Model.StandardsScore,
            ("6S standard", a => a.SixSStandardMaintained),
            ("TPM schedule", a => a.TpmScheduleFollowed),
            ("Standard work visible", a => a.StandardWorkVisible));

        RenderCategoryPanel("performance", "Performance", Model.PerfScore,
            ("Weekly plan tracking", a => a.TrackingAgainstWeeklyPlan),
            ("Metrics owned", a => a.MetricsVisibleAndOwned),
            ("CI actions progressing", a => a.ImprovementActionsProgressing));

        <div class="sd-panel" id="panel-records">
            <div class="card">
                <div class="card-head">
                    <span class="card-title">Audit records</span>
                    <span class="card-sub">@Model.TotalAudits total</span>
                </div>
                <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
                    <table class="dash-table" style="min-width:640px">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Area</th>
                                <th>Auditor</th>
                                <th>Score</th>
                                <th>Verdict</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Audits)
                            {
                                var score = SeniorAuditScoring.OverallScore(a);
                                <tr>
                                    <td>@a.AuditDate.ToString("dd/MM/yyyy")</td>
                                    <td style="font-weight:600">@a.Area</td>
                                    <td>@a.AuditorName</td>
                                    <td><span style="color:@SeniorDashboardModel.GaugeColor(score);font-weight:700">@score%</span></td>
                                    <td><span class="rag @SeniorDashboardModel.Rc(a.OverallVerdict)">@(a.OverallVerdict ?? "—")</span></td>
                                    <td><a asp-page="/SeniorAudit" asp-route-id="@a.Id" class="dl-link">View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    void RenderGaugeCard(int pct, string label)
    {
        var color = SeniorDashboardModel.GaugeColor(pct);
        var angle = (int)(pct * 2.7 - 135);
        <div class="chart-card">
            <div class="chart-card-head">
                <span class="chart-title">@label</span>
            </div>
            <div class="sd-gauge-wrap">
                <svg viewBox="0 0 120 80" class="sd-gauge-svg">
                    <path d="M 15 70 A 45 45 0 1 1 105 70" fill="none" stroke="#e5e7eb" stroke-width="8" stroke-linecap="round"/>
                    <path d="M 15 70 A 45 45 0 1 1 105 70" fill="none" stroke="@color" stroke-width="8" stroke-linecap="round"
                          stroke-dasharray="@(pct * 1.41) 200"/>
                    <line x1="60" y1="70" x2="60" y2="32" stroke="@color" stroke-width="2.5" stroke-linecap="round"
                          transform="rotate(@angle 60 70)"/>
                    <circle cx="60" cy="70" r="4" fill="@color"/>
                </svg>
                <div class="sd-gauge-val" style="color:@color">@pct%</div>
            </div>
        </div>
    }

    void RenderCategoryPanel(string tabId, string title, int score,
        params (string Label, Func<SeniorWeeklyAudit, bool?> Field)[] fields)
    {
        <div class="sd-panel" id="panel-@tabId">
            <div class="card" style="margin-bottom:14px">
                <div class="card-head">
                    <span class="card-title">@title</span>
                    <span class="card-sub" style="font-weight:700;color:@SeniorDashboardModel.GaugeColor(score)">@score% avg</span>
                </div>
                <div class="sd-cat-body">
                    <div class="sd-gauge-side">
                        @{ RenderGaugeCard(score, "Category"); }
                    </div>
                    <div class="sd-checklist">
                        @foreach (var f in fields)
                        {
                            var answered = Model.Audits.Where(a => f.Field(a).HasValue).ToList();
                            var pass = answered.Count(a => f.Field(a) == true);
                            var pct = answered.Count > 0 ? pass * 100 / answered.Count : 0;
                            <div class="sd-check-row">
                                <span>@f.Label</span>
                                <span class="sd-check-pct" style="color:@SeniorDashboardModel.GaugeColor(pct)">@pct%</span>
                                <div class="sd-check-bar"><div class="sd-check-fill" style="width:@(pct)%;background:@SeniorDashboardModel.GaugeColor(pct)"></div></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
