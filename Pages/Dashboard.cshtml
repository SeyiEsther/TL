@page
@model DashboardModel
@using TL.Models
@{
    ViewData["Title"] = "Dashboard";
    var safetyDom   = Model.SafetyRed   > 0 ? "r" : Model.SafetyAmber   > 0 ? "a" : Model.SafetyGreen   > 0 ? "g" : "u";
    var safetyLabel = Model.SafetyRed   > 0 ? "Red" : Model.SafetyAmber > 0 ? "Amber" : Model.SafetyGreen > 0 ? "Green" : "—";
    var qualDom     = Model.QualityRed  > 0 ? "r" : Model.QualityAmber  > 0 ? "a" : Model.QualityGreen  > 0 ? "g" : "u";
    var qualLabel   = Model.QualityRed  > 0 ? "Red" : Model.QualityAmber> 0 ? "Amber" : Model.QualityGreen> 0 ? "Green" : "—";
    var perfDom     = Model.PerfRed     > 0 ? "r" : Model.PerfAmber     > 0 ? "a" : Model.PerfGreen     > 0 ? "g" : "u";
    var perfLabel   = Model.PerfRed     > 0 ? "Red" : Model.PerfAmber   > 0 ? "Amber" : Model.PerfGreen   > 0 ? "Green" : "—";
    var hColor      = Model.HealthScore >= 67 ? "#16a34a" : Model.HealthScore >= 34 ? "#f59e0b" : "#CC1F2C";
}

<div class="dwrap">

    <!-- ── FILTERS ── -->
    <div class="card dash-filter-card">
        <form method="get" class="filters">
            <div class="sf"><label>From</label><input type="date" name="from" value="@Model.From"></div>
            <div class="sf"><label>To</label><input type="date" name="to" value="@Model.To"></div>
            <div class="sf">
                <label>Shift</label>
                <select name="shift">
                    <option value="">All shifts</option>
                    <option value="Day"       selected="@(Model.ShiftFilter == "Day")">Day</option>
                    <option value="Afternoon" selected="@(Model.ShiftFilter == "Afternoon")">Afternoon</option>
                    <option value="Night"     selected="@(Model.ShiftFilter == "Night")">Night</option>
                </select>
            </div>
            <div class="sf">
                <label>Area</label>
                <select name="area" style="max-width:200px">
                    <option value="">All areas</option>
                    @foreach (var grp in AreaList.All.GroupBy(a => a.Group))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var a in grp)
                            {
                                <option value="@a.Label" selected="@(Model.AreaFilter == a.Label)">@a.Label</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="sf"><label>Team leader</label><input type="text" name="tl" value="@Model.TlFilter" placeholder="Search name…" style="min-width:140px"></div>
            <button type="submit" class="sbtn sm">Filter</button>
            <a asp-page="/Dashboard" class="sbtn sm">Clear</a>
            <a href="/api/submissions/export/csv@(Model.CsvQuery)" class="sbtn sm" style="margin-left:auto">&#8595; CSV</a>
        </form>
    </div>

    <!-- ── STAT STRIP ── -->
    <div class="stat-strip">
        <div class="stat-item">
            <div class="stat-val">@Model.Shifts.Count</div>
            <div class="stat-lbl">Total shifts</div>
        </div>
        <div class="stat-item">
            <div class="stat-val" style="color:#16a34a">@Model.Today</div>
            <div class="stat-lbl">Today</div>
        </div>
        <div class="stat-item">
            <div class="stat-val">@Model.ThisWeek</div>
            <div class="stat-lbl">This week</div>
        </div>
        <div class="stat-item">
            <div class="stat-val" style="color:@(Model.WithEscalations > 0 ? "#b45309" : "inherit")">@Model.WithEscalations</div>
            <div class="stat-lbl">Escalations</div>
        </div>
        <div class="stat-item">
            <div class="stat-val" style="color:#3b82f6">@Model.DayShifts</div>
            <div class="stat-lbl">Day</div>
        </div>
        <div class="stat-item">
            <div class="stat-val" style="color:#f59e0b">@Model.AfternoonShifts</div>
            <div class="stat-lbl">Afternoon</div>
        </div>
        <div class="stat-item stat-item-last">
            <div class="stat-val" style="color:#6366f1">@Model.NightShifts</div>
            <div class="stat-lbl">Night</div>
        </div>
    </div>

    <!-- ── STATUS CLUSTER ── -->
    @{
        var sTotal = Model.SafetyGreen  + Model.SafetyAmber  + Model.SafetyRed;
        var qTotal = Model.QualityGreen + Model.QualityAmber + Model.QualityRed;
        var pTotal = Model.PerfGreen    + Model.PerfAmber    + Model.PerfRed;
    }
    <div class="status-cluster">
        <div class="status-pane">
            <div class="sp-label">&#128737; Safety</div>
            <div class="sp-wheel-wrap">
                <canvas id="safetyChart"></canvas>
                <div class="sp-wheel-center">
                    <div class="sp-pct @safetyDom">@(sTotal > 0 ? $"{Model.SafetyGreen * 100 / sTotal}%" : "—")</div>
                    <div class="sp-pct-sub">green</div>
                </div>
            </div>
            <div class="sp-status @safetyDom">@safetyLabel</div>
            <div class="sp-tally">
                <span class="sp-g">@Model.SafetyGreen G</span>
                <span class="sp-a">@Model.SafetyAmber A</span>
                <span class="sp-r">@Model.SafetyRed R</span>
            </div>
        </div>
        <div class="status-pane">
            <div class="sp-label">&#9989; Quality</div>
            <div class="sp-wheel-wrap">
                <canvas id="qualityChart"></canvas>
                <div class="sp-wheel-center">
                    <div class="sp-pct @qualDom">@(qTotal > 0 ? $"{Model.QualityGreen * 100 / qTotal}%" : "—")</div>
                    <div class="sp-pct-sub">green</div>
                </div>
            </div>
            <div class="sp-status @qualDom">@qualLabel</div>
            <div class="sp-tally">
                <span class="sp-g">@Model.QualityGreen G</span>
                <span class="sp-a">@Model.QualityAmber A</span>
                <span class="sp-r">@Model.QualityRed R</span>
            </div>
        </div>
        <div class="status-pane">
            <div class="sp-label">&#9881; Performance</div>
            <div class="sp-wheel-wrap">
                <canvas id="perfChart"></canvas>
                <div class="sp-wheel-center">
                    <div class="sp-pct @perfDom">@(pTotal > 0 ? $"{Model.PerfGreen * 100 / pTotal}%" : "—")</div>
                    <div class="sp-pct-sub">green</div>
                </div>
            </div>
            <div class="sp-status @perfDom">@perfLabel</div>
            <div class="sp-tally">
                <span class="sp-g">@Model.PerfGreen G</span>
                <span class="sp-a">@Model.PerfAmber A</span>
                <span class="sp-r">@Model.PerfRed R</span>
            </div>
        </div>
        <div class="health-pane">
            <div class="sp-label">Health index</div>
            <div class="sp-wheel-wrap">
                <canvas id="healthChart"></canvas>
                <div class="sp-wheel-center">
                    <div class="sp-pct" style="color:@hColor">@Model.HealthScore<span style="font-size:11px;font-weight:500">%</span></div>
                    <div class="sp-pct-sub" style="color:#9ca3af">score</div>
                </div>
            </div>
            <div class="health-bar-bg" style="margin-top:8px">
                <div class="health-bar-fill" style="width:@Model.HealthScore%;background:@hColor"></div>
            </div>
            <div class="health-bands"><span>Poor</span><span>Excellent</span></div>
        </div>
    </div>

    <!-- ── THIS WEEK: walkaround priority + completion ── -->
    <div class="week-panels">

        <div class="card" style="overflow:hidden">
            <div style="background:var(--ink);padding:11px 16px;display:flex;align-items:baseline;justify-content:space-between;gap:8px">
                <div style="color:#fff;font-size:12px;font-weight:700;letter-spacing:.04em">&#127919; WALKAROUND PRIORITY</div>
                <div style="color:#9ca3af;font-size:11px">Mon @Model.WeekStart.ToString("dd MMM") &ndash; Sun @Model.WeekEnd.ToString("dd MMM")</div>
            </div>
            @if (!Model.WorstAreasThisWeek.Any())
            {
                <div class="empty">No shift data this week.</div>
            }
            else
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th style="width:28px;text-align:center">#</th>
                            <th>Area</th>
                            <th style="text-align:center;color:#CC1F2C;width:46px">Reds</th>
                            <th style="text-align:center;color:#b45309;width:46px">Ambs</th>
                            <th style="min-width:90px">This week</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int wrank = 0; }
                        @foreach (var a in Model.WorstAreasThisWeek)
                        {
                            wrank++;
                            var isTop = wrank == 1 && a.Reds > 0;
                            <tr style="@(isTop ? "background:#fff5f5" : "")">
                                <td style="text-align:center">
                                    @if (isTop)
                                    {
                                        <span style="display:inline-block;background:#CC1F2C;color:#fff;font-size:10px;font-weight:700;width:20px;height:20px;line-height:20px;border-radius:50%;text-align:center">1</span>
                                    }
                                    else
                                    {
                                        <span style="font-size:11px;color:var(--muted)">@wrank</span>
                                    }
                                </td>
                                <td>
                                    <a asp-page="/Dashboard" asp-route-area="@a.Area" style="font-weight:600;color:var(--ink);text-decoration:none">@a.Area</a>
                                    @if (isTop) { <span style="margin-left:5px;font-size:10px;color:#CC1F2C;font-weight:700">&#9650; GO HERE</span> }
                                </td>
                                <td style="text-align:center">
                                    @if (a.Reds > 0) { <span style="font-size:14px;font-weight:700;color:#CC1F2C">@a.Reds</span> }
                                    else { <span style="color:var(--muted)">—</span> }
                                </td>
                                <td style="text-align:center">
                                    @if (a.Ambers > 0) { <span style="font-size:13px;font-weight:600;color:#b45309">@a.Ambers</span> }
                                    else { <span style="color:var(--muted)">—</span> }
                                </td>
                                <td>
                                    <div style="display:flex;height:7px;border-radius:4px;overflow:hidden;gap:1px">
                                        @if (a.Reds   > 0) { <div style="flex:@a.Reds;background:#CC1F2C"></div> }
                                        @if (a.Ambers > 0) { <div style="flex:@a.Ambers;background:#f59e0b"></div> }
                                        @if (a.Greens > 0) { <div style="flex:@a.Greens;background:#16a34a"></div> }
                                    </div>
                                    <div style="font-size:10px;color:var(--muted);margin-top:2px">@a.TotalShifts shift@(a.TotalShifts==1?"":"s") &bull; @a.RedPct% red</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card" style="overflow:hidden">
            <div style="background:var(--ink);padding:11px 16px;display:flex;align-items:baseline;justify-content:space-between;gap:8px">
                <div style="color:#fff;font-size:12px;font-weight:700;letter-spacing:.04em">&#128203; SHIFT COMPLETION</div>
                <div style="color:#9ca3af;font-size:11px">
                    <span style="color:#3b82f6;font-weight:600">@Model.WeekDayTotal D</span>&nbsp;
                    <span style="color:#f59e0b;font-weight:600">@Model.WeekAfternoonTotal A</span>&nbsp;
                    <span style="color:#6366f1;font-weight:600">@Model.WeekNightTotal N</span>
                </div>
            </div>
            @if (!Model.WeekCompletion.Any())
            {
                <div class="empty">No shifts submitted this week.</div>
            }
            else
            {
                <div class="completion-scroll">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Team Leader</th>
                                <th style="text-align:center;width:40px">Day</th>
                                <th style="text-align:center;width:40px">Aft</th>
                                <th style="text-align:center;width:44px">Night</th>
                                <th style="text-align:center;width:48px;font-weight:700">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.WeekCompletion)
                            {
                                <tr>
                                    <td style="font-weight:500">@row.TL</td>
                                    <td style="text-align:center;color:@(row.Day       > 0 ? "#3b82f6" : "var(--muted)")">@(row.Day       > 0 ? row.Day.ToString()       : "—")</td>
                                    <td style="text-align:center;color:@(row.Afternoon > 0 ? "#f59e0b" : "var(--muted)")">@(row.Afternoon > 0 ? row.Afternoon.ToString() : "—")</td>
                                    <td style="text-align:center;color:@(row.Night     > 0 ? "#6366f1" : "var(--muted)")">@(row.Night     > 0 ? row.Night.ToString()     : "—")</td>
                                    <td style="text-align:center;font-weight:700">@row.Total</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

    <!-- ── 14-DAY ACTIVITY (compact full-width) ── -->
    <div class="card activity-card">
        <div class="activity-head">
            <span class="activity-title">14-Day Activity</span>
            <span style="font-size:10px;color:var(--muted)">Shifts per day</span>
        </div>
        <canvas id="activityChart" style="max-height:72px;display:block"></canvas>
    </div>

    <!-- ── SHIFTS TABLE ── -->
    <div class="card">
        <div class="card-head">
            <span class="card-title">Shifts</span>
            <span class="card-sub">@Model.Shifts.Count record@(Model.Shifts.Count == 1 ? "" : "s")</span>
        </div>
        @if (!Model.Shifts.Any())
        {
            <div class="empty">No shifts match the current filters.</div>
        }
        else
        {
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
                <table class="dash-table" style="min-width:720px">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Shift</th>
                            <th>Area</th>
                            <th>Team leader</th>
                            <th>Safety</th>
                            <th>Quality</th>
                            <th>Perf</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Shifts)
                        {
                            <tr>
                                <td>@s.ShiftDate.ToString("dd/MM/yyyy")</td>
                                <td>@s.Shift</td>
                                <td>@(s.Area ?? "—")</td>
                                <td>@s.TeamLeaderDisplay</td>
                                <td>
                                    <span class="rag @DashboardModel.Rc(s.OverallSafetyStatus)">@(s.OverallSafetyStatus ?? "—")</span>
                                    @if (s.SafetyFlags.Any() && (s.OverallSafetyStatus == "Amber" || s.OverallSafetyStatus == "Red"))
                                    {
                                        <div class="flag-list">@string.Join(" · ", s.SafetyFlags.Take(2))@(s.SafetyFlags.Count > 2 ? $" +{s.SafetyFlags.Count - 2}" : "")</div>
                                    }
                                </td>
                                <td>
                                    <span class="rag @DashboardModel.Rc(s.OverallQualityStatus)">@(s.OverallQualityStatus ?? "—")</span>
                                    @if (s.QualityFlags.Any() && (s.OverallQualityStatus == "Amber" || s.OverallQualityStatus == "Red"))
                                    {
                                        <div class="flag-list">@string.Join(" · ", s.QualityFlags.Take(2))@(s.QualityFlags.Count > 2 ? $" +{s.QualityFlags.Count - 2}" : "")</div>
                                    }
                                </td>
                                <td>
                                    <span class="rag @DashboardModel.Rc(s.OverallPerfStatus)">@(s.OverallPerfStatus ?? "—")</span>
                                    @if (s.PerfFlags.Any() && (s.OverallPerfStatus == "Amber" || s.OverallPerfStatus == "Red"))
                                    {
                                        <div class="flag-list">@string.Join(" · ", s.PerfFlags.Take(2))@(s.PerfFlags.Count > 2 ? $" +{s.PerfFlags.Count - 2}" : "")</div>
                                    }
                                </td>
                                <td>@s.SubmittedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                <td style="white-space:nowrap">
                                    <a asp-page="/Form" asp-route-id="@s.Id" class="dl-link">Edit</a>
                                    &nbsp;
                                    <a href="/api/submissions/@s.Id/pdf" class="dl-link">PDF</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    const C = { green:'#16a34a', amber:'#f59e0b', red:'#CC1F2C', blue:'#3b82f6', gray:'#e9ebee', ink:'#0f1117' };
    Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";
    Chart.defaults.font.size   = 11;

    function ragDonut(id, g, a, r) {
        const total = g + a + r;
        new Chart(document.getElementById(id), {
            type: 'doughnut',
            data: {
                datasets: [{
                    data: total > 0 ? [g, a, r] : [1, 0, 0],
                    backgroundColor: total > 0 ? [C.green, C.amber, C.red] : [C.gray],
                    borderWidth: 3,
                    borderColor: '#fff',
                }]
            },
            options: {
                cutout: '70%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => {
                                const labels = ['Green','Amber','Red'];
                                return ` ${labels[ctx.dataIndex]}: ${ctx.raw}${total > 0 ? ' (' + Math.round(ctx.raw / total * 100) + '%)' : ''}`;
                            }
                        }
                    }
                }
            }
        });
    }

    ragDonut('safetyChart',  @Model.SafetyGreen,  @Model.SafetyAmber,  @Model.SafetyRed);
    ragDonut('qualityChart', @Model.QualityGreen, @Model.QualityAmber, @Model.QualityRed);
    ragDonut('perfChart',    @Model.PerfGreen,    @Model.PerfAmber,    @Model.PerfRed);

    // Health score donut
    const hScore = @Model.HealthScore;
    const hColor = hScore >= 67 ? C.green : hScore >= 34 ? C.amber : C.red;
    new Chart(document.getElementById('healthChart'), {
        type: 'doughnut',
        data: {
            datasets: [{
                data: hScore > 0 ? [hScore, 100 - hScore] : [1, 99],
                backgroundColor: hScore > 0 ? [hColor, C.gray] : [C.gray, '#2d2d2d'],
                borderWidth: 3,
                borderColor: '#0f1117',
            }]
        },
        options: {
            cutout: '70%',
            plugins: { legend: { display: false }, tooltip: { enabled: false } }
        }
    });

    new Chart(document.getElementById('activityChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Model.J(Model.ActivityLabels)),
            datasets: [{
                label: 'Shifts',
                data: @Html.Raw(Model.J(Model.ActivityData)),
                backgroundColor: ctx => ctx.raw === 0 ? C.gray : C.red,
                borderRadius: 4,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.raw} shift${ctx.raw !== 1 ? 's' : ''}` } } },
            scales: {
                x: { grid: { display: false }, ticks: { maxRotation: 0, font: { size: 10 } } },
                y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1, font: { size: 10 } }, grid: { color: '#f0f0f0' } }
            }
        }
    });
})();
</script>
