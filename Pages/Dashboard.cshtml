@page
@model DashboardModel
@using TL.Services
@{ ViewData["Title"] = "Dashboard"; }

<div class="dwrap">

    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">
                Operations Dashboard@(Model.CustomRange ? "" : $" — Week {Model.WeekNumber}")
            </div>
            <div class="page-sub">
                @if (Model.CustomRange)
                {
                    <span>@Model.Shifts.Count shifts &bull; custom date range</span>
                }
                else
                {
                    <span>@Model.WeekLabel@(Model.IsCurrentWeek ? " · current week" : " · report")</span>
                }
            </div>
        </div>
        <a href="/api/submissions/export/csv@(Model.CsvQuery)" class="sbtn primary sm">&#8595; Export CSV</a>
    </div>

    @if (!Model.CustomRange)
    {
        <div class="card" style="margin-bottom:14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:12px 16px">
            <a asp-page="/Dashboard" asp-route-week="@Model.PrevWeekStart.ToString("yyyy-MM-dd")" class="sbtn sm">&larr; Week @(WeekMath.IsoWeekNumber(Model.PrevWeekStart))</a>
            <form method="get" style="margin:0">
                <select name="week" class="ff-input" style="min-width:230px" onchange="this.form.submit()">
                    @foreach (var w in Model.RecentWeeks)
                    {
                        <option value="@w.Start.ToString("yyyy-MM-dd")" selected="@(w.Start == Model.WeekStart ? "selected" : null)">@w.Label</option>
                    }
                </select>
            </form>
            @if (Model.NextWeekStart.HasValue)
            {
                <a asp-page="/Dashboard" asp-route-week="@Model.NextWeekStart.Value.ToString("yyyy-MM-dd")" class="sbtn sm">Week @(WeekMath.IsoWeekNumber(Model.NextWeekStart.Value)) &rarr;</a>
            }
            @if (!Model.IsCurrentWeek)
            {
                <a asp-page="/Dashboard" class="sbtn sm primary">Jump to current week</a>
            }
        </div>

        @if (Model.UnderperformingShiftCount > 0)
        {
            <div class="card" style="margin-bottom:14px;padding:12px 16px;background:#fef2f2;border-color:#fecaca;color:#991b1b;font-weight:600;display:flex;align-items:center;gap:10px">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                @Model.UnderperformingShiftCount shift@(Model.UnderperformingShiftCount == 1 ? "" : "s") below the @DashboardModel.ShiftTarget target this week — see Target vs Actual below.
            </div>
        }
    }

    <div class="card card-filter" style="margin-bottom:14px">
        <form method="get" class="filters">
            <partial name="_DatePicker" model='new DatePickerModel("from", Model.From, "From")' />
            <partial name="_DatePicker" model='new DatePickerModel("to", Model.To, "To")' />
            <partial name="_FilterShift" model='new FilterDropdownModel("shift", "Shift", Model.ShiftFilter, "All shifts")' />
            <partial name="_FilterArea" model='new FilterDropdownModel("area", "Area", Model.AreaFilter, "All areas")' />
            <div class="ff">
                <span class="ff-label">Team leader</span>
                <div class="ff-control">
                    <svg class="ff-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" name="tl" class="ff-input" value="@Model.TlFilter" placeholder="Search name…" style="min-width:180px">
                </div>
            </div>
            <div class="filter-actions">
                <button type="submit" class="sbtn sm filter-apply">Apply filters</button>
                <a asp-page="/Dashboard" class="sbtn sm">Clear</a>
            </div>
        </form>
    </div>

    <div class="kpi-row" style="margin-bottom:14px">
        <div class="kpi kpi-blue">
            <div class="kpi-icon-wrap kpi-icon-blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            </div>
            <div class="kpi-label">Total Shifts</div>
            <div class="kpi-val">@Model.Shifts.Count</div>
            <div class="kpi-sub">Filtered results</div>
        </div>
        <div class="kpi kpi-indigo">
            <div class="kpi-icon-wrap kpi-icon-indigo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <div class="kpi-label">This Week</div>
            <div class="kpi-val">@Model.ThisWeek</div>
            <div class="kpi-sub">Last 7 days</div>
        </div>
        <div class="kpi kpi-green">
            <div class="kpi-icon-wrap kpi-icon-green">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <div class="kpi-label">Today</div>
            <div class="kpi-val" style="color:#16a34a">@Model.Today</div>
            <div class="kpi-sub">Active shifts</div>
        </div>
        <div class="kpi kpi-amber">
            <div class="kpi-icon-wrap kpi-icon-amber">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="kpi-label">Incomplete</div>
            <div class="kpi-val" style="color:#b45309">@Model.IncompleteShifts</div>
            <div class="kpi-sub">Missing hours / 6S / sign-off</div>
        </div>
        <div class="kpi kpi-amber">
            <div class="kpi-icon-wrap kpi-icon-amber">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <div class="kpi-label">Escalations</div>
            <div class="kpi-val" style="color:#b45309">@Model.WithEscalations</div>
            <div class="kpi-sub">With escalations</div>
        </div>
    </div>

    <div class="chart-grid-4" style="margin-bottom:14px">
        <div class="chart-card">
            <div class="chart-card-head">
                <span class="chart-title">Safety Status</span>
                <span class="rag g" style="font-size:10px">@Model.SafetyGreen G</span>
            </div>
            <div style="position:relative;max-width:160px;margin:0 auto">
                <canvas id="safetyChart"></canvas>
                <div class="donut-center">
                    <div class="donut-pct @(Model.SafetyGreen + Model.SafetyAmber + Model.SafetyRed > 0 ? DashboardModel.Rc(Model.SafetyGreen >= Model.SafetyAmber && Model.SafetyGreen >= Model.SafetyRed ? "Green" : Model.SafetyAmber >= Model.SafetyRed ? "Amber" : "Red") : "u")">
                        @(Model.SafetyGreen + Model.SafetyAmber + Model.SafetyRed > 0 ? $"{Model.SafetyGreen * 100 / (Model.SafetyGreen + Model.SafetyAmber + Model.SafetyRed)}%" : "—")
                    </div>
                    <div style="font-size:9px;color:var(--muted)">green</div>
                </div>
            </div>
            <div class="rag-legend">
                <span class="rag-dot" style="background:#16a34a"></span><span>@Model.SafetyGreen</span>
                <span class="rag-dot" style="background:#f59e0b"></span><span>@Model.SafetyAmber</span>
                <span class="rag-dot" style="background:#CC1F2C"></span><span>@Model.SafetyRed</span>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-card-head">
                <span class="chart-title">Quality Status</span>
                <span class="rag g" style="font-size:10px">@Model.QualityGreen G</span>
            </div>
            <div style="position:relative;max-width:160px;margin:0 auto">
                <canvas id="qualityChart"></canvas>
                <div class="donut-center">
                    <div class="donut-pct @(Model.QualityGreen + Model.QualityAmber + Model.QualityRed > 0 ? DashboardModel.Rc(Model.QualityGreen >= Model.QualityAmber && Model.QualityGreen >= Model.QualityRed ? "Green" : Model.QualityAmber >= Model.QualityRed ? "Amber" : "Red") : "u")">
                        @(Model.QualityGreen + Model.QualityAmber + Model.QualityRed > 0 ? $"{Model.QualityGreen * 100 / (Model.QualityGreen + Model.QualityAmber + Model.QualityRed)}%" : "—")
                    </div>
                    <div style="font-size:9px;color:var(--muted)">green</div>
                </div>
            </div>
            <div class="rag-legend">
                <span class="rag-dot" style="background:#16a34a"></span><span>@Model.QualityGreen</span>
                <span class="rag-dot" style="background:#f59e0b"></span><span>@Model.QualityAmber</span>
                <span class="rag-dot" style="background:#CC1F2C"></span><span>@Model.QualityRed</span>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-card-head">
                <span class="chart-title">Performance Status</span>
                <span class="rag g" style="font-size:10px">@Model.PerfGreen G</span>
            </div>
            <div style="position:relative;max-width:160px;margin:0 auto">
                <canvas id="perfChart"></canvas>
                <div class="donut-center">
                    <div class="donut-pct @(Model.PerfGreen + Model.PerfAmber + Model.PerfRed > 0 ? DashboardModel.Rc(Model.PerfGreen >= Model.PerfAmber && Model.PerfGreen >= Model.PerfRed ? "Green" : Model.PerfAmber >= Model.PerfRed ? "Amber" : "Red") : "u")">
                        @(Model.PerfGreen + Model.PerfAmber + Model.PerfRed > 0 ? $"{Model.PerfGreen * 100 / (Model.PerfGreen + Model.PerfAmber + Model.PerfRed)}%" : "—")
                    </div>
                    <div style="font-size:9px;color:var(--muted)">green</div>
                </div>
            </div>
            <div class="rag-legend">
                <span class="rag-dot" style="background:#16a34a"></span><span>@Model.PerfGreen</span>
                <span class="rag-dot" style="background:#f59e0b"></span><span>@Model.PerfAmber</span>
                <span class="rag-dot" style="background:#CC1F2C"></span><span>@Model.PerfRed</span>
            </div>
        </div>

        <div class="chart-card gauge-card">
            <div class="chart-card-head">
                <span class="chart-title">Health Score</span>
            </div>
            <canvas id="gaugeChart" style="max-width:220px;display:block;margin:0 auto"></canvas>
            <div style="text-align:center;margin-top:6px">
                <div class="gauge-score-val">@Model.HealthScore<span style="font-size:14px;font-weight:400;color:var(--muted)">%</span></div>
                <div style="font-size:10px;color:var(--muted);letter-spacing:.05em;text-transform:uppercase;margin-top:2px">Health Index</div>
            </div>
            <div class="gauge-bands" style="margin-top:8px">
                <span style="color:#CC1F2C;font-size:10px;font-weight:600">Poor</span>
                <span style="font-size:10px;color:var(--muted)">▸ ▸ ▸</span>
                <span style="color:#16a34a;font-size:10px;font-weight:600">Excellent</span>
            </div>
        </div>
    </div>

    <div class="chart-grid-act" style="margin-bottom:14px">
        <div class="chart-card">
            <div class="chart-card-head">
                <span class="chart-title">14-Day Activity</span>
                <span style="font-size:10px;color:var(--muted)">Shifts per day</span>
            </div>
            <canvas id="activityChart" style="max-height:200px"></canvas>
        </div>
        <div class="chart-card">
            <div class="chart-card-head">
                <span class="chart-title">Target vs Actual</span>
                <span style="font-size:10px;color:var(--muted)">Completed &amp; signed-off forms</span>
            </div>
            @if (Model.CustomRange)
            {
                <div class="empty" style="font-size:12px">Switch to a week view to see target vs actual.</div>
            }
            else
            {
                var weekUnder = Model.WeekAchieved < DashboardModel.WeekTarget;
                <div style="position:relative;max-width:180px;margin:0 auto">
                    <canvas id="targetActualChart"></canvas>
                </div>
                <div class="shift-type-legend">
                    <div class="shift-type-item"><span class="rag-dot" style="background:#3b82f6"></span>Day <strong>@Model.WeekAchievedDay</strong></div>
                    <div class="shift-type-item"><span class="rag-dot" style="background:#f59e0b"></span>Afternoon <strong>@Model.WeekAchievedAfternoon</strong></div>
                    <div class="shift-type-item"><span class="rag-dot" style="background:#6366f1"></span>Night <strong>@Model.WeekAchievedNight</strong></div>
                </div>
                <div style="text-align:center;margin-top:8px;font-weight:700;color:@(weekUnder ? "#dc2626" : "#16a34a")">
                    @Model.WeekAchieved / @DashboardModel.WeekTarget done
                </div>
            }
        </div>
    </div>

    @if (!Model.CustomRange)
    {
        <div class="card" style="margin-bottom:14px">
            <div class="card-head">
                <span class="card-title">Per-shift target vs actual</span>
                <span class="card-sub">Target @DashboardModel.ShiftTarget per shift &bull; @DashboardModel.DayTarget per day &bull; @DashboardModel.WeekTarget per week</span>
            </div>
            @if (Model.ShiftTargets.Count == 0)
            {
                <div class="empty">No shifts recorded for this week yet.</div>
            }
            else
            {
                <div style="overflow-x:auto">
                    <table class="dash-table" style="min-width:640px">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Shift</th>
                                <th>Achieved</th>
                                <th>Target</th>
                                <th>Progress</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.ShiftTargets)
                            {
                                <tr style="@(r.Under ? "background:#fef2f2" : null)">
                                    <td>@r.Date.ToString("ddd dd/MM")</td>
                                    <td>@r.Shift</td>
                                    <td style="font-weight:700;color:@(r.Under ? "#dc2626" : "#16a34a")">@r.Achieved</td>
                                    <td>@r.Target</td>
                                    <td style="min-width:140px">
                                        <div style="height:8px;border-radius:5px;background:#eef2f7;overflow:hidden">
                                            <div style="height:100%;width:@(r.Pct)%;background:@(r.Under ? "#dc2626" : "#16a34a")"></div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (r.Under)
                                        {
                                            <span class="rag r">Below target</span>
                                        }
                                        else
                                        {
                                            <span class="rag g">On target</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @if (Model.WorstAreas.Count > 0)
    {
        <div class="card" style="margin-bottom:14px">
            <div class="card-head">
                <div>
                    <span class="card-title">Worst Performing Areas</span>
                    <span class="card-sub" style="margin-left:8px">ranked by red RAG ratings &mdash; Friday walkaround priority</span>
                </div>
                <span style="font-size:10px;color:var(--muted)">Safety &bull; Quality &bull; Performance combined</span>
            </div>
            <table class="dash-table">
                <thead>
                    <tr>
                        <th style="width:32px;text-align:center">#</th>
                        <th>Area</th>
                        <th style="text-align:center;color:#CC1F2C">&#x25CF; Reds</th>
                        <th style="text-align:center;color:#b45309">&#x25CF; Ambers</th>
                        <th style="text-align:center">Greens</th>
                        <th style="text-align:center">Shifts</th>
                        <th style="min-width:120px">RAG breakdown</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 0; }
                    @foreach (var a in Model.WorstAreas)
                    {
                        rank++;
                        <tr>
                            <td style="text-align:center;font-size:11px;font-weight:700;color:var(--muted)">@rank</td>
                            <td style="font-weight:600">@a.Area</td>
                            <td style="text-align:center">
                                <span style="font-size:14px;font-weight:700;color:#CC1F2C">@a.Reds</span>
                            </td>
                            <td style="text-align:center">
                                <span style="font-size:13px;font-weight:600;color:#b45309">@a.Ambers</span>
                            </td>
                            <td style="text-align:center;color:#16a34a;font-weight:600">@a.Greens</td>
                            <td style="text-align:center;color:var(--muted)">@a.TotalShifts</td>
                            <td>
                                <div style="display:flex;height:10px;border-radius:5px;overflow:hidden;gap:1px">
                                    @if (a.RedPct > 0)   { <div style="flex:@a.RedPct;background:#CC1F2C;min-width:2px"></div> }
                                    @if (a.AmberPct > 0) { <div style="flex:@a.AmberPct;background:#f59e0b;min-width:2px"></div> }
                                    @if (a.GreenPct > 0) { <div style="flex:@a.GreenPct;background:#16a34a;min-width:2px"></div> }
                                </div>
                                <div style="font-size:10px;color:var(--muted);margin-top:2px">@a.RedPct% red</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="card">
        <div class="card-head">
            <span class="card-title">Shifts</span>
            <span class="card-sub">@Model.Shifts.Count shifts</span>
        </div>
        @if (!Model.Shifts.Any())
        {
            <div class="empty">No shifts match the current filters.</div>
        }
        else
        {
            <table class="dash-table">
                <thead>
                    <tr><th>Date</th><th>Shift</th><th>Area</th><th>Team leader</th><th>Complete</th><th>Safety</th><th>Quality</th><th>Perf</th><th>Submitted</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Shifts)
                    {
                        Model.CompletionById.TryGetValue(s.Id, out var comp);
                        var complete = comp?.IsComplete == true;
                        <tr>
                            <td>@s.ShiftDate.ToString("dd/MM/yyyy")</td>
                            <td>@s.Shift</td>
                            <td>@(s.Area ?? "—")</td>
                            <td>@s.TeamLeaderDisplay</td>
                            <td>
                                @if (complete)
                                {
                                    <span class="rag g" title="All hours, 6S/TPM and sign-off complete">Complete</span>
                                }
                                else
                                {
                                    <span class="rag r" title="@(comp != null ? string.Join(", ", comp.MissingItems.Take(3)) : "Incomplete")">
                                        @(comp != null ? $"{comp.HoursComplete}/{comp.HoursTotal} hrs" : "—")
                                    </span>
                                }
                            </td>
                            <td><span class="rag @DashboardModel.Rc(s.OverallSafetyStatus)">@(s.OverallSafetyStatus ?? "—")</span></td>
                            <td><span class="rag @DashboardModel.Rc(s.OverallQualityStatus)">@(s.OverallQualityStatus ?? "—")</span></td>
                            <td><span class="rag @DashboardModel.Rc(s.OverallPerfStatus)">@(s.OverallPerfStatus ?? "—")</span></td>
                            <td>@s.SubmittedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                            <td><a href="/api/submissions/@s.Id/pdf" class="dl-link pdf-dl" data-filename="@($"TLSW_{s.ShiftDate:yyyyMMdd}_{s.Shift}.pdf")">PDF</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
    if (typeof Chart === 'undefined') return;
    const C = {
        green: '#16a34a', amber: '#f59e0b', red: '#CC1F2C',
        blue: '#3b82f6', indigo: '#6366f1', gray: '#e9ebee', ink: '#0f1117',
    };

    Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";
    Chart.defaults.font.size = 11;

    function ragDonut(id, g, a, r) {
        const total = g + a + r;
        return new Chart(document.getElementById(id), {
            type: 'doughnut',
            data: {
                labels: ['Green', 'Amber', 'Red'],
                datasets: [{
                    data: total > 0 ? [g, a, r] : [1, 0, 0],
                    backgroundColor: total > 0 ? [C.green, C.amber, C.red] : [C.gray],
                    borderWidth: 3,
                    borderColor: '#fff',
                }]
            },
            options: {
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => ` ${ctx.label}: ${ctx.raw}${total > 0 ? ' (' + Math.round(ctx.raw / total * 100) + '%)' : ''}`
                        }
                    }
                }
            }
        });
    }

    ragDonut('safetyChart', @Model.SafetyGreen, @Model.SafetyAmber, @Model.SafetyRed);
    ragDonut('qualityChart', @Model.QualityGreen, @Model.QualityAmber, @Model.QualityRed);
    ragDonut('perfChart', @Model.PerfGreen, @Model.PerfAmber, @Model.PerfRed);

    const score = @Model.HealthScore;
    const gaugeColor = score >= 67 ? C.green : score >= 34 ? C.amber : C.red;

    const needlePlugin = {
        id: 'needle',
        afterDatasetDraw(chart) {
            const { ctx } = chart;
            const meta = chart.getDatasetMeta(0);
            if (!meta.data.length) return;
            const arc = meta.data[0];
            const cx = arc.x, cy = arc.y;
            const innerR = arc.innerRadius;
            const outerR = arc.outerRadius;
            const angleRad = Math.PI + (score / 100 * Math.PI);
            const len = (innerR + outerR) / 2 * 0.92;

            ctx.save();
            ctx.shadowColor = 'rgba(0,0,0,0.15)';
            ctx.shadowBlur = 4;
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.lineTo(cx + len * Math.cos(angleRad), cy + len * Math.sin(angleRad));
            ctx.strokeStyle = C.ink;
            ctx.lineWidth = 3.5;
            ctx.lineCap = 'round';
            ctx.stroke();
            ctx.shadowBlur = 0;
            ctx.beginPath();
            ctx.arc(cx, cy, 7, 0, Math.PI * 2);
            ctx.fillStyle = C.ink;
            ctx.fill();
            ctx.beginPath();
            ctx.arc(cx, cy, 3, 0, Math.PI * 2);
            ctx.fillStyle = '#fff';
            ctx.fill();
            ctx.restore();
        }
    };

    new Chart(document.getElementById('gaugeChart'), {
        type: 'doughnut',
        data: {
            datasets: [{
                data: score > 0 ? [score, 100 - score] : [1, 99],
                backgroundColor: score > 0 ? [gaugeColor, C.gray] : [C.gray, C.gray],
                borderWidth: 0,
            }]
        },
        options: {
            circumference: 180,
            rotation: 180,
            aspectRatio: 2,
            cutout: '62%',
            plugins: { legend: { display: false }, tooltip: { enabled: false } }
        },
        plugins: [needlePlugin]
    });

    new Chart(document.getElementById('activityChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Model.J(Model.ActivityLabels)),
            datasets: [{
                label: 'Shifts',
                data: @Html.Raw(Model.J(Model.ActivityData)),
                backgroundColor: ctx => {
                    const v = ctx.raw;
                    return v === 0 ? C.gray : C.red;
                },
                borderRadius: 5,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.raw} shift${ctx.raw !== 1 ? 's' : ''}` } } },
            scales: {
                x: { grid: { display: false }, ticks: { maxRotation: 45 } },
                y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 }, grid: { color: '#f0f0f0' } }
            }
        }
    });

    const taChart = document.getElementById('targetActualChart');
    if (taChart) {
        const taData = [@Model.WeekAchievedDay, @Model.WeekAchievedAfternoon, @Model.WeekAchievedNight];
        const taTotal = taData.reduce((a, b) => a + b, 0);
        new Chart(taChart, {
            type: 'pie',
            data: {
                labels: ['Day', 'Afternoon', 'Night'],
                datasets: [{
                    data: taTotal > 0 ? taData : [1, 1, 1],
                    backgroundColor: taTotal > 0 ? [C.blue, C.amber, C.indigo] : [C.gray, C.gray, C.gray],
                    borderWidth: 3,
                    borderColor: '#fff',
                }]
            },
            options: {
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => taTotal > 0 ? ` ${ctx.label}: ${ctx.raw} done` : ' No audits yet' } }
                }
            }
        });
    }

})();
</script>
