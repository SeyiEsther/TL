@page
@model HistoryModel
@using TL.Models
@{ ViewData["Title"] = "History";
   var tabs = new[] { "all", "shifts", "hod", "senior", "handovers" }; }

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">History</div>
            <div class="page-sub">@Model.Rows.Count record@(Model.Rows.Count == 1 ? "" : "s") &bull; @Model.TabLabel(Model.Tab)</div>
        </div>
    </div>

    <div class="card card-filter" style="margin-bottom:14px">
        <form method="get" class="filters">
            <input type="hidden" name="tab" value="@Model.Tab">
            <partial name="_DatePicker" model='new DatePickerModel("from", Model.From, "From")' />
            <partial name="_DatePicker" model='new DatePickerModel("to", Model.To, "To")' />
            <partial name="_FilterArea" model='new FilterDropdownModel("area", "Area", Model.AreaFilter, "All areas")' />
            <div class="ff">
                <span class="ff-label">Name</span>
                <div class="ff-control">
                    <svg class="ff-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" name="q" class="ff-input" value="@Model.PersonFilter" placeholder="Team leader or auditor…" style="min-width:180px">
                </div>
            </div>
            <div class="filter-actions">
                <button type="submit" class="sbtn sm filter-apply">Apply filters</button>
                <a asp-page="/History" asp-route-tab="@Model.Tab" class="sbtn sm">Clear</a>
            </div>
        </form>
    </div>

    <div class="sd-tab-bar card" style="margin-bottom:14px;padding:8px 12px">
        @foreach (var t in tabs)
        {
            <a asp-page="/History"
               asp-route-tab="@t"
               asp-route-from="@Model.From"
               asp-route-to="@Model.To"
               asp-route-area="@Model.AreaFilter"
               asp-route-q="@Model.PersonFilter"
               class="sd-tab @(Model.Tab == t ? "active" : "")"
               style="text-decoration:none">@Model.TabLabel(t)</a>
        }
    </div>

    <div class="card">
        <div class="card-head">
            <span class="card-title">@Model.TabLabel(Model.Tab)</span>
            <span class="card-sub">@Model.Rows.Count record@(Model.Rows.Count == 1 ? "" : "s")</span>
        </div>
        @if (!Model.Rows.Any())
        {
            <div class="empty">No records found for the selected filters.</div>
        }
        else
        {
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
                <table class="dash-table" style="min-width:900px">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Shift</th>
                            <th>Area</th>
                            <th>Person</th>
                            <th>Safety</th>
                            <th>Quality</th>
                            <th>Perf</th>
                            <th>Verdict / Score</th>
                            <th>Flags</th>
                            <th>Submitted</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td><span style="font-size:11px;font-weight:600;color:var(--muted)">@r.TypeLabel</span></td>
                                <td>@r.Date.ToString("dd/MM/yyyy")</td>
                                <td>@(r.ShiftOrExtra ?? "—")</td>
                                <td style="font-weight:600">@r.Area</td>
                                <td>@r.Person</td>
                                <td><span class="rag @HistoryModel.Rc(r.Safety)">@(r.Safety ?? "—")</span></td>
                                <td><span class="rag @HistoryModel.Rc(r.Quality)">@(r.Quality ?? "—")</span></td>
                                <td><span class="rag @HistoryModel.Rc(r.Perf)">@(r.Perf ?? "—")</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.Verdict))
                                    {
                                        <span class="rag @HistoryModel.Rc(r.Verdict)">@r.Verdict</span>
                                    }
                                    else if (r.Score.HasValue)
                                    {
                                        <span style="font-weight:700">@r.Score%</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--muted)">—</span>
                                    }
                                </td>
                                <td style="font-size:11px;white-space:nowrap">
                                    @if (r.HasActions) { <span style="color:#b45309;font-weight:600">&#9888; Actions</span> }
                                    @if (r.HandoverPending) { <span style="color:#b45309;font-weight:600">&#9203; Pending ack</span> }
                                    @if (!r.HasActions && !r.HandoverPending) { <span style="color:var(--muted)">—</span> }
                                </td>
                                <td>@r.SubmittedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                <td style="white-space:nowrap">
                                    @switch (r.TabKey)
                                    {
                                        case "shifts":
                                            <a asp-page="/Form" asp-route-id="@r.Id" class="dl-link">Edit</a>
                                            <a href="/api/submissions/@r.Id/pdf" class="dl-link pdf-dl" data-filename="TLSW_@(r.Date.ToString("yyyyMMdd")).pdf">PDF</a>
                                            break;
                                        case "hod":
                                            @if (r.IsNewHodAudit)
                                            {
                                                <a asp-page="/AuditResult" asp-route-id="@r.Id" class="dl-link">View</a>
                                                <a asp-page="/Audit" asp-route-id="@r.Id" class="dl-link">Edit</a>
                                            }
                                            else
                                            {
                                                <a asp-page="/AuditResult" asp-route-id="@r.Id" class="dl-link">View</a>
                                                <a href="/api/submissions/@r.Id/pdf" class="dl-link pdf-dl" data-filename="TLSW_@(r.Date.ToString("yyyyMMdd")).pdf">PDF</a>
                                            }
                                            break;
                                        case "senior":
                                            <a asp-page="/SeniorAudit" asp-route-id="@r.Id" class="dl-link">View</a>
                                            break;
                                        case "handovers":
                                            <a asp-page="/Form" asp-route-id="@r.Id" class="dl-link">View</a>
                                            @if (r.HandoverPending)
                                            {
                                                <a asp-page="/Handover" asp-route-area="@r.Area" class="dl-link">Ack</a>
                                            }
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
