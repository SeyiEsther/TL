@page
@model HistoryModel
@{ ViewData["Title"] = "History"; }

<div class="dwrap">
    <div class="page-head">
        <div class="page-title">Shift history</div>
        <a asp-page="/Handover" class="sbtn sm">&#128203; Handover history</a>
    </div>

    <div class="card" style="margin-bottom:14px">
        <form method="get" class="filters">
            <div class="sf"><label>From</label><input type="date" name="from" value="@Model.From"></div>
            <div class="sf"><label>To</label><input type="date" name="to" value="@Model.To"></div>
            <button type="submit" class="sbtn sm">Filter</button>
            <a asp-page="/History" class="sbtn sm">Clear</a>
        </form>
    </div>

    <div class="card">
        <div class="card-head">
            <span class="card-title">All shifts</span>
            <span class="card-sub">@Model.Shifts.Count shifts</span>
        </div>
        @if (!Model.Shifts.Any())
        {
            <div class="empty">No shifts found for the selected period.</div>
        }
        else
        {
            <table class="dash-table">
                <thead>
                    <tr><th>Date</th><th>Shift</th><th>Area</th><th>Team leader</th><th>Safety</th><th>Quality</th><th>Perf</th><th>Submitted</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Shifts)
                    {
                        <tr>
                            <td>@s.ShiftDate.ToString("dd/MM/yyyy")</td>
                            <td>@s.Shift</td>
                            <td>@(s.Area ?? "—")</td>
                            <td>@s.TeamLeaderDisplay</td>
                            <td><span class="rag @HistoryModel.Rc(s.OverallSafetyStatus)">@(s.OverallSafetyStatus ?? "—")</span></td>
                            <td><span class="rag @HistoryModel.Rc(s.OverallQualityStatus)">@(s.OverallQualityStatus ?? "—")</span></td>
                            <td><span class="rag @HistoryModel.Rc(s.OverallPerfStatus)">@(s.OverallPerfStatus ?? "—")</span></td>
                            <td>@s.SubmittedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                            <td>
                                <a asp-page="/Form" asp-route-id="@s.Id" class="dl-link">Edit</a>
                                &nbsp;
                                <a href="/api/submissions/@s.Id/pdf" class="dl-link">PDF</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
