@page
@model AuditModel
@using TL.Services
@using TL.Pages
@{ ViewData["Title"] = Model.AuditTypeLabel;
   var auditDateDisplay = DateOnly.TryParse(Model.AuditDate, out var ad) ? ad.ToString("dd/MM/yyyy") : Model.AuditDate;
   var sections = Model.Questions.GroupBy(q => q.Section).ToList();
   var tpmBoardCount = Model.Questions.Select(q => q.MachineName).Where(m => m != null).Distinct().Count();
   int qIndex = 0; }

<div class="audit-wrap" data-audit-form data-binary-audit>

    <div class="audit-sticky">
        <div class="audit-sticky-top">
            <div>
                <div class="audit-sticky-title">@Model.AuditTypeLabel</div>
                <div class="audit-sticky-sub">
                    @auditDateDisplay &bull; Audit: <strong>@Model.Department</strong> &bull; TL check: <strong>@Model.EffectivenessArea</strong>
                    @if (!string.IsNullOrEmpty(Model.AuditorName)) { <span> &bull; @Model.AuditorName</span> }
                </div>
            </div>
            @if (Model.EditingId.HasValue) { <span class="audit-badge-editing">Editing</span> }
            <div class="audit-progress-meta">
                <div class="audit-progress-track"><div class="audit-progress-fill"></div></div>
                <span class="audit-progress-text">0/0</span>
            </div>
        </div>
        <nav class="audit-sec-nav" aria-label="Audit sections">
            @foreach (var sec in sections)
            {
                var sid = "sec-" + sec.Key.Replace(" ", "-").Replace("—", "").ToLowerInvariant();
                <a href="#@sid" class="audit-sec-link">@sec.Key.Split('—').First().Trim()</a>
            }
            <a href="#sec-effectiveness" class="audit-sec-link">TL Check</a>
            <a href="#sec-findings" class="audit-sec-link">Findings</a>
        </nav>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="err" style="margin-bottom:14px">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    @if (Model.EditingId.HasValue)
    {
        <div style="background:#fef3c7;border:1px solid #fcd34d;border-radius:10px;padding:10px 16px;margin-bottom:14px;font-size:12px;color:#b45309">
            Editing existing audit.
        </div>
    }

    @{
        var complianceIssues = Model.EffectivenessFindings.Count(f => f.IsAuditFinding && !string.IsNullOrEmpty(f.TeamLeader));
        var unsignedCount = Model.EffectivenessFindings.Count(f => !string.IsNullOrEmpty(f.TeamLeader) && !f.OutgoingSignedOff);
        var handoverPending = Model.EffectivenessFindings.Count(f => !string.IsNullOrEmpty(f.TeamLeader) && f.OutgoingSignedOff && !f.IncomingHandoverAcknowledged);
    }
    @if (complianceIssues > 0 || Model.EffectivenessFindings.Any(f => f.CloseStatus == "No forms"))
    {
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin-bottom:14px;font-size:12px;color:#991b1b;line-height:1.5">
            <strong>Shift form compliance:</strong>
            @if (Model.EffectivenessFindings.Any(f => f.CloseStatus == "No forms"))
            {
                <span> No TL shift forms submitted for <strong>@Model.EffectivenessArea</strong> this week.</span>
            }
            else
            {
                <span> @complianceIssues shift(s) need attention this week.</span>
                if (unsignedCount > 0) { <span> @unsignedCount unsigned.</span> }
                if (handoverPending > 0) { <span> @handoverPending handover pending.</span> }
            }
            Review the TL effectiveness table below before scoring the walkaround.
        </div>
    }

    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px 16px;margin-bottom:14px;font-size:12px;color:#1e40af;line-height:1.5">
        <strong>Walkaround audit:</strong> Score the whole <strong>@Model.Department</strong> department — Pass (1) or Fail (0) for each item.
        @if (Model.AuditType == HodAuditTypes.Tpm)
        {
            <span> Includes every TPM board across @Model.Department@(tpmBoardCount > 1 ? $" ({tpmBoardCount} boards)" : "").</span>
        }
    </div>
    <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:12px 16px;margin-bottom:14px;font-size:12px;color:#166534;line-height:1.5">
        <strong>Effectiveness check:</strong> Verifies what TLs claimed on shift forms for zone <strong>@Model.EffectivenessArea</strong> only — see the table below.
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="auditDate" value="@Model.AuditDate">
        <input type="hidden" name="auditorName" value="@Model.AuditorName">
        <input type="hidden" name="department" value="@Model.Department">
        <input type="hidden" name="effectivenessArea" value="@Model.EffectivenessArea">
        <input type="hidden" name="auditType" value="@Model.AuditType">
        @if (Model.EditingId.HasValue) { <input type="hidden" name="editingId" value="@Model.EditingId"> }

        @foreach (var sec in sections)
        {
            var sid = "sec-" + sec.Key.Replace(" ", "-").Replace("—", "").ToLowerInvariant();
            var secQuestions = sec.ToList();
            var secMax = secQuestions.Count;
            <div class="audit-card" id="@sid">
                <div class="audit-head perf">
                    <div class="audit-acc"></div>
                    <span>@sec.Key</span>
                    <span class="audit-sec-score" data-section-max="@secMax" style="margin-left:auto;font-size:11px;color:var(--muted)">0 / @secMax</span>
                </div>
                <div class="audit-body">
                    @foreach (var q in secQuestions)
                    {
                        var inp = Model.A.FirstOrDefault(a => a.QuestionId == q.Id)
                            ?? new HodAnswerInput { QuestionId = q.Id };
                        var passVal = inp.Pass;
                        var pId = $"q_{q.Id}_pass";
                        var fId = $"q_{q.Id}_fail";
                        <input type="hidden" name="A[@qIndex].QuestionId" value="@q.Id">
                        <div class="audit-q" data-binary-q>
                            <span class="audit-q-text">@q.Label</span>
                            <div class="audit-yn audit-binary">
                                <input type="radio" class="ayn-y" name="A[@qIndex].Pass" id="@pId" value="true" checked="@(passVal == true ? "checked" : null)">
                                <label for="@pId" title="Pass — meets standard">Pass (1)</label>
                                <input type="radio" class="ayn-n" name="A[@qIndex].Pass" id="@fId" value="false" checked="@(passVal == false ? "checked" : null)">
                                <label for="@fId" title="Fail — does not meet standard">Fail (0)</label>
                            </div>
                        </div>
                        <div class="audit-note">
                            <label class="audit-note-lbl">Evidence / comments</label>
                            <textarea name="A[@qIndex].Evidence" class="audit-ta" placeholder="What you observed…">@inp.Evidence</textarea>
                        </div>
                        qIndex++;
                    }
                </div>
            </div>
        }

        <!-- Score summary -->
        <div class="audit-card" id="sec-score">
            <div class="audit-head final"><div class="audit-acc"></div><span>Score Summary</span></div>
            <div class="audit-body">
                <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
                    <div style="font-size:28px;font-weight:800;color:@HodAuditScoring.BandColor(Model.TotalScore, Model.MaxScore)">
                        <span id="live-total">@(Model.TotalScore > 0 || Model.A.Any(a => a.Pass.HasValue) ? Model.TotalScore : "—")</span>
                        <span style="font-size:16px;color:var(--muted)">/ <span id="live-max">@Model.MaxScore</span></span>
                    </div>
                    <div>
                        <div id="live-band" style="font-weight:700;font-size:14px">@Model.RatingBand</div>
                        <div id="live-detail" style="font-size:11px;color:var(--muted);max-width:320px">@Model.RatingDetail</div>
                    </div>
                </div>
                <div style="margin-top:12px;font-size:11px;color:var(--muted)">
                    Rating: 0–40% Poor &bull; 40–72% Needs Improvement &bull; 72–92% Good &bull; 92–100% Excellent
                </div>
            </div>
        </div>

        <!-- TL Effectiveness -->
        <div class="audit-card" id="sec-effectiveness">
            <div class="audit-head quality"><div class="audit-acc"></div><span>TL Form Effectiveness Check</span></div>
            <div class="audit-body">
                <p style="font-size:12px;color:var(--muted);margin:0 0 12px">
                    Who submitted shift forms this week, whether they are signed off, and what still needs closing.
                    Rows highlighted in red are audit findings. Fail answers that contradict TL claims are auto-linked on submit.
                </p>
                @if (Model.EffectivenessFindings.Count == 0)
                {
                    <div style="padding:12px;background:#f0fdf4;border-radius:8px;font-size:13px;color:#166534">
                        No TL shift forms found for this area this week.
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto">
                        <table class="dash-table" style="min-width:820px;font-size:12px">
                            <thead>
                                <tr>
                                    <th>Team leader</th>
                                    <th>Shift</th>
                                    <th>Date</th>
                                    <th>Form status</th>
                                    <th>Sign-off</th>
                                    <th>Close status</th>
                                    <th>What to verify</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.EffectivenessFindings)
                                {
                                    var rowStyle = f.IsAuditFinding || f.TlClaimMismatch ? "background:#fef2f2" : null;
                                    <tr style="@rowStyle">
                                        <td style="font-weight:600">@(string.IsNullOrEmpty(f.TeamLeader) ? "—" : f.TeamLeader)</td>
                                        <td>@(string.IsNullOrEmpty(f.Shift) ? "—" : f.Shift)</td>
                                        <td>@(f.ShiftDate == default ? "—" : f.ShiftDate.ToString("dd/MM"))</td>
                                        <td>
                                            @if (string.IsNullOrEmpty(f.TeamLeader))
                                            {
                                                <span class="rag r">No forms</span>
                                            }
                                            else if (f.FormComplete)
                                            {
                                                <span class="rag g">Complete</span>
                                            }
                                            else
                                            {
                                                <span class="rag r">@f.HoursComplete/@f.HoursTotal hrs</span>
                                            }
                                        </td>
                                        <td>
                                            @if (string.IsNullOrEmpty(f.TeamLeader))
                                            {
                                                <span>—</span>
                                            }
                                            else if (f.OutgoingSignedOff)
                                            {
                                                <span class="rag g">Signed</span>
                                            }
                                            else
                                            {
                                                <span class="rag r">Unsigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (string.IsNullOrEmpty(f.TeamLeader))
                                            {
                                                <span class="rag r">@f.CloseStatus</span>
                                            }
                                            else
                                            {
                                                var closeCls = f.CloseStatus == "Closed correctly" ? "g"
                                                    : f.CloseStatus == "Handover pending" ? "a" : "r";
                                                <span class="rag @closeCls">@f.CloseStatus</span>
                                            }
                                        </td>
                                        <td style="color:var(--muted)">
                                            @string.Join(" · ", f.Issues)
                                            @if (f.TlClaimMismatch && f.LinkedAuditFailures.Count > 0)
                                            {
                                                <div style="color:#b91c1c;margin-top:4px;font-weight:600">
                                                    Mismatch: @string.Join("; ", f.LinkedAuditFailures)
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Findings -->
        <div class="audit-card audit-findings-card" id="sec-findings">
            <div class="card-head"><span class="card-title">Actions required</span></div>
            <div class="audit-findings-body">
                <div class="sfield full">
                    <label>Actions raised / concerns identified</label>
                    <textarea name="Actions" placeholder="What was found and what action is needed…">@Model.Actions</textarea>
                </div>
                <div class="sfield full">
                    <label>Good practice observed</label>
                    <textarea name="GoodPractice" placeholder="Positive examples noted during the walkaround…">@Model.GoodPractice</textarea>
                </div>
            </div>
        </div>

        <!-- Sign off -->
        <div class="audit-sign-card">
            <div class="audit-sign-title">Sign off</div>
            <div class="sf-row">
                <div class="fl">
                    <label>Auditor signature</label>
                    <input type="text" name="auditorSignature" value="@Model.AuditorSignature" placeholder="Full name…" required>
                </div>
                <div class="fl">
                    <label>Area team leader signature</label>
                    <input type="text" name="teamLeaderSignature" value="@Model.TeamLeaderSignature" placeholder="Full name…">
                </div>
            </div>
            <div class="audit-sign-hint">By signing, you confirm this audit record is accurate and complete.</div>
        </div>

        <div class="audit-footer">
            <button type="submit" class="sbtn primary">
                @(Model.EditingId.HasValue ? "Save changes" : "Submit audit")
            </button>
            <a asp-page="/AuditStart" class="sbtn">Cancel</a>
        </div>
    </form>
</div>

<script>
(function () {
    var wrap = document.querySelector('[data-binary-audit]');
    if (!wrap) return;
    var form = wrap.querySelector('form');
    var maxScore = @Model.MaxScore;

    function bandFor(pct) {
        if (pct >= 92) return { band: 'Excellent', detail: 'Best practice standard maintained. Continue to sustain.', color: '#22c55e' };
        if (pct >= 72) return { band: 'Good', detail: 'Minor improvements required. Follow up within one week.', color: '#3b82f6' };
        if (pct >= 40) return { band: 'Needs Improvement', detail: 'Significant gaps identified. Action plan required within 48 hours.', color: '#f59e0b' };
        return { band: 'Poor', detail: 'Immediate corrective action required. Area must not be signed off.', color: '#ef4444' };
    }

    function updateScores() {
        var groups = {};
        form.querySelectorAll('.audit-binary input[type="radio"]').forEach(function (r) {
            if (!groups[r.name]) groups[r.name] = null;
            if (r.checked) groups[r.name] = r.value === 'true';
        });
        var names = Object.keys(groups);
        var done = names.filter(function (n) { return groups[n] !== null; }).length;
        var total = names.filter(function (n) { return groups[n] === true; }).length;

        var fill = wrap.querySelector('.audit-progress-fill');
        var text = wrap.querySelector('.audit-progress-text');
        if (fill) fill.style.width = (names.length ? Math.round(done / names.length * 100) : 0) + '%';
        if (text) text.textContent = done + '/' + names.length;

        var liveTotal = document.getElementById('live-total');
        var liveBand = document.getElementById('live-band');
        var liveDetail = document.getElementById('live-detail');
        if (liveTotal) liveTotal.textContent = done === names.length ? total : '—';
        if (done === names.length && names.length > 0) {
            var pct = total * 100 / names.length;
            var b = bandFor(pct);
            if (liveBand) { liveBand.textContent = b.band; liveBand.style.color = b.color; }
            if (liveDetail) liveDetail.textContent = b.detail;
            if (liveTotal) liveTotal.style.color = b.color;
        }

        wrap.querySelectorAll('.audit-card[id^="sec-"]').forEach(function (card) {
            var badge = card.querySelector('.audit-sec-score');
            if (!badge) return;
            var secMax = +badge.dataset.sectionMax || 0;
            var radios = card.querySelectorAll('.audit-binary input[type="radio"]:checked');
            var secTotal = 0;
            radios.forEach(function (r) { if (r.value === 'true') secTotal++; });
            badge.textContent = secTotal + ' / ' + secMax;
        });
    }

    form.addEventListener('change', updateScores);
    updateScores();
})();
</script>
