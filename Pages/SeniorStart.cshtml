@page
@model SeniorStartModel
@using TL.Models
@{ ViewData["Title"] = "Senior Team Audit";
   var defaultArea = Model.SuggestedAreas.FirstOrDefault()?.Area; }

<div class="welcome-wrap">
    <div class="welcome-card" style="max-width:560px">
        <div style="display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:4px">
            <div style="width:32px;height:32px;background:#1e3a5f;border-radius:8px;display:flex;align-items:center;justify-content:center">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
            </div>
            <div class="welcome-name" style="margin-bottom:0">Senior Team Weekly Audit</div>
        </div>
        <div class="welcome-time">@DateTime.Now.ToString("dddd d MMMM yyyy")</div>

        @if (Model.DutyWeek is { } duty)
        {
            <div class="senior-duty-reminder">
                <div class="senior-duty-head">
                    <div>
                        <div class="senior-duty-label">On duty this week &bull; Week @duty.IsoWeek</div>
                        <div class="senior-duty-team">Week @duty.IsoWeek</div>
                        <div class="senior-duty-dates">@duty.WeekStart.ToString("dd MMM") &ndash; @duty.WeekEnd.ToString("dd MMM yyyy")</div>
                    </div>
                    <a asp-page="/SeniorRota" class="senior-duty-rota-link">Full rota</a>
                </div>
                <div class="senior-duty-people">
                    @foreach (var person in duty.Team)
                    {
                        <span class="senior-duty-person" title="@person">
                            <span class="senior-duty-avatar" style="background:@SeniorRota.AvatarColor(person, Model.SeniorNames)">@SeniorRota.Initials(person)</span>
                            @person
                        </span>
                    }
                </div>
            </div>
        }

        @if (Model.SuggestedAreas.Count > 0)
        {
            <div class="area-rec-box">
                <div class="area-rec-head">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    Recommended — worst performing this week
                </div>
                <div class="area-rec-pills" id="area-rec-pills">
                    @foreach (var s in Model.SuggestedAreas)
                    {
                        <button type="button" class="area-rec-pill" data-area="@s.Area" title="@s.Area — @s.Reason">
                            <span class="area-rec-pill-name">@s.ShortLabel</span>
                            <span class="area-rec-pill-meta">@s.Reason</span>
                        </button>
                    }
                </div>
            </div>
        }

        <form method="post" class="start-form">
            @Html.AntiForgeryToken()

            <div class="sf-row" style="margin-bottom:14px">
                <div class="fl">
                    <label>Audit date</label>
                    <input type="date" name="auditDate" value="@Model.AuditDate" required>
                </div>
                <div class="fl">
                    <label>Auditor name</label>
                    <input type="text" name="auditorName" value="@Model.AuditorName" placeholder="Your full name" required>
                </div>
            </div>

            <div class="fl" style="margin-bottom:6px">
                <label>Area to audit <span style="color:var(--red)">*</span></label>
                <select name="area" id="senior-area-select" required>
                    <option value="">Select area…</option>
                    @foreach (var grp in AreaList.All.GroupBy(a => a.Group))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var a in grp)
                            {
                                var disp = string.IsNullOrEmpty(a.Machines) ? a.Label : $"{a.Label} ({a.Machines})";
                                var selected = defaultArea == a.Label;
                                <option value="@a.Label" selected="@(selected ? "selected" : null)">@disp</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="err">@Model.Error</div>
            }

            <button type="submit" class="welcome-btn primary" style="margin-top:16px">Start audit &rarr;</button>
            <a asp-page="/SeniorDashboard" class="welcome-btn secondary" style="margin-bottom:10px">Senior dashboard</a>
            <a asp-page="/Index" class="welcome-btn secondary">Back to home</a>
        </form>
    </div>
</div>

<script>
(function () {
    var select = document.getElementById('senior-area-select');
    var pills = document.querySelectorAll('.area-rec-pill');
    if (!select || !pills.length) return;

    function syncPillActive() {
        var val = select.value;
        pills.forEach(function (p) {
            p.classList.toggle('active', p.getAttribute('data-area') === val);
        });
    }

    pills.forEach(function (pill) {
        pill.addEventListener('click', function () {
            var area = pill.getAttribute('data-area');
            if (!area) return;
            select.value = area;
            syncPillActive();
        });
    });

    select.addEventListener('change', syncPillActive);
    syncPillActive();
})();
</script>
