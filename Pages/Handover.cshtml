@page
@model HandoverModel
@using TL.Models
@{ ViewData["Title"] = "Handover history"; }

<div class="dwrap">
    <div class="page-head">
        <div>
            <div class="page-title">Handover history</div>
            <div class="page-sub">Completed shift handovers with sign-off status</div>
        </div>
        <a asp-page="/History" asp-route-tab="handovers" asp-route-area="@Model.SelectedArea" class="sbtn sm">All handovers</a>
    </div>

    <!-- Area selector -->
    <div style="background:var(--white);border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin-bottom:16px">
        <form method="get">
            <div class="fl">
                <label>Area</label>
                <select name="area" style="padding:10px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;font-family:inherit;color:var(--ink);background:var(--white)">
                    <option value="">Select area…</option>
                    @foreach (var grp in AreaList.All.GroupBy(a => a.Group))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var a in grp)
                            {
                                <option value="@a.Label" selected="@(Model.SelectedArea == a.Label)">@a.Label</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <button type="submit" class="sbtn" style="margin-top:10px">View handovers</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.SelectedArea) && !Model.Handovers.Any())
    {
        <div class="card"><div class="empty">No signed-off handovers found for this area yet.</div></div>
    }

    @if (Model.Handovers.Any())
    {
        var pending = Model.Handovers.Where(h => h.IsPending).ToList();
        var completed = Model.Handovers.Where(h => !h.IsPending).ToList();

        @if (pending.Any())
        {
            <div style="font-size:11px;font-weight:700;color:#b45309;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px">
                &#9888; Incoming TL sign-off pending (@pending.Count)
            </div>
            @foreach (var r in pending)
            {
                @RenderHandoverCard(r, true)
            }
        }

        @if (completed.Any())
        {
            if (pending.Any())
            {
                <div style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px;margin-top:14px">Completed handovers</div>
            }
            @foreach (var r in completed)
            {
                @RenderHandoverCard(r, false)
            }
        }
    }
</div>

@functions {
    string FormatAge(TimeSpan t)
    {
        if (t.TotalMinutes < 60) return $"{(int)t.TotalMinutes}m";
        if (t.TotalHours < 24) return $"{(int)t.TotalHours}h {t.Minutes}m";
        return $"{(int)t.TotalDays}d {t.Hours}h";
    }
}

@{
    async Task RenderHandoverCard(HandoverModel.HandoverRecord r, bool isPending)
    {
        var borderColor = isPending ? "#fcd34d" : "var(--border)";
        var bgColor = isPending ? "#fffbeb" : "var(--white)";
        <div style="background:@bgColor;border:@(isPending ? "1.5px" : "1px") solid @borderColor;border-radius:10px;overflow:hidden;margin-bottom:10px">
            <!-- Header row -->
            <div style="padding:14px 18px;background:var(--surface);border-bottom:1px solid @borderColor;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
                <div>
                    <div style="font-size:14px;font-weight:700">@r.Shift shift &mdash; @r.ShiftDate.ToString("dd/MM/yyyy")</div>
                    <div style="font-size:12px;color:var(--muted);margin-top:2px">
                        TL: <strong>@r.TeamLeaderDisplay</strong> &nbsp;&middot;&nbsp; @r.HoursCompleted hrs &nbsp;&middot;&nbsp; submitted @r.SubmittedAt.ToLocalTime().ToString("HH:mm, dd MMM")
                    </div>
                </div>
                <div style="display:flex;gap:6px;align-items:center">
                    <span class="rv @HandoverModel.Rc(r.SafetyStatus)" style="font-size:11px">@(r.SafetyStatus ?? "—")</span>
                    <span class="rv @HandoverModel.Rc(r.QualityStatus)" style="font-size:11px">@(r.QualityStatus ?? "—")</span>
                    <span class="rv @HandoverModel.Rc(r.PerfStatus)" style="font-size:11px">@(r.PerfStatus ?? "—")</span>
                    <a href="/api/submissions/@r.Id/pdf" target="_blank" class="sbtn sm" style="margin-left:4px">&#8595; PDF</a>
                </div>
            </div>

            <!-- Signature row -->
            <div style="padding:14px 18px;display:grid;grid-template-columns:1fr 1fr;gap:0">
                <!-- Outgoing TL -->
                <div style="padding-right:16px;border-right:1px solid var(--border)">
                    <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;color:#16a34a;margin-bottom:4px">Outgoing TL</div>
                    <div style="font-size:13px;font-weight:600">@r.OutgoingTLSignature</div>
                    <div style="font-size:11px;color:var(--muted);margin-top:2px">Signed @r.SubmittedAt.ToLocalTime().ToString("HH:mm, dd MMM yyyy")</div>
                </div>
                <!-- Incoming TL -->
                <div style="padding-left:16px">
                    @if (isPending)
                    {
                        <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;color:#b45309;margin-bottom:4px">&#9888; Incoming TL sign-off pending</div>
                        <div style="font-size:11px;color:#b45309">Waiting @FormatAge(r.PendingFor)</div>
                    }
                    else
                    {
                        <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;color:#16a34a;margin-bottom:4px">Incoming TL</div>
                        <div style="font-size:13px;font-weight:600">@r.IncomingTLSignature</div>
                        if (r.IncomingTLSignedAt.HasValue)
                        {
                            <div style="font-size:11px;color:var(--muted);margin-top:2px">Signed @r.IncomingTLSignedAt.Value.ToLocalTime().ToString("HH:mm, dd MMM yyyy")</div>
                        }
                    }
                </div>
            </div>
        </div>
    }
}
