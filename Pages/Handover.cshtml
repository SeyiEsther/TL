@page
@model HandoverModel
@{ ViewData["Title"] = "Handover History"; }

<div class="wrap">
    <div class="page-head">
        <div>
            <div class="page-title">Handover history</div>
            <div class="page-sub">Select an area to view handover records</div>
        </div>
    </div>

    <div style="background:var(--white);border:1px solid var(--border);border-radius:10px;padding:18px 20px;margin-bottom:16px">
        <form method="get">
            <div class="fl">
                <label>Area</label>
                <select name="area" style="padding:10px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;font-family:inherit;color:var(--ink);background:var(--white)">
                    <option value="">Select an area…</option>
                    @foreach (var grp in AreaList.All.GroupBy(a => a.Group))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var a in grp)
                            {
                                <option value="@a.Label" selected="@(Model.SelectedArea == a.Label)">@a.Label</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <button type="submit" class="sbtn" style="margin-top:10px">View handovers</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.SelectedArea) && !Model.Records.Any())
    {
        <div class="card"><div class="empty">No handover records found for this area yet.</div></div>
    }

    @foreach (var r in Model.Records)
    {
        <div class="card @(r.IsPending ? "ho-pending" : "")" style="margin-bottom:10px;border-radius:10px;overflow:hidden">
            <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
                <div>
                    <div style="font-size:14px;font-weight:700">@r.Shift shift — @r.ShiftDate.ToString("dd/MM/yyyy")</div>
                    <div style="font-size:12px;color:var(--muted);margin-top:2px">@Model.SelectedArea &nbsp;&middot;&nbsp; TL: @r.TeamLeaderDisplay</div>
                </div>
                @if (r.IsPending)
                {
                    <span class="ho-pending-badge">&#9888; Pending sign-off</span>
                }
                <a asp-page="/Form" asp-route-id="@r.Id" class="dl-link" style="font-size:12px">Edit</a>
            </div>
            <div style="padding:14px 18px;display:flex;gap:24px;flex-wrap:wrap">
                <div style="flex:1;min-width:180px">
                    <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700;margin-bottom:6px">Outgoing TL</div>
                    @if (!string.IsNullOrEmpty(r.OutgoingTLSignature))
                    {
                        <div class="ho-sig">
                            <span class="ho-sig-tick">&#10003;</span>
                            <span class="ho-sig-name">@r.OutgoingTLSignature</span>
                            <span class="ho-sig-time">@r.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                    }
                    else
                    {
                        <div style="font-size:12px;color:var(--muted);font-style:italic">Not yet signed</div>
                    }
                </div>
                <div style="flex:1;min-width:180px">
                    <div style="font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700;margin-bottom:6px">Incoming TL</div>
                    @if (!string.IsNullOrEmpty(r.IncomingTLSignature))
                    {
                        <div class="ho-sig">
                            <span class="ho-sig-tick">&#10003;</span>
                            <span class="ho-sig-name">@r.IncomingTLSignature</span>
                            <span class="ho-sig-time">@(r.IncomingTLSignedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "")</span>
                        </div>
                    }
                    else
                    {
                        <span class="ho-pending-badge">&#9888; Pending sign-off</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
