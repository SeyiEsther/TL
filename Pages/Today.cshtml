@page
@model TodayModel
@{ ViewData["Title"] = "Today"; }

<div class="wrap">
    <div class="page-head">
        <div>
            <div class="page-title">Today's shifts</div>
            <div class="page-sub">@DateTime.Today.ToString("dddd d MMMM yyyy")</div>
        </div>
    </div>

    @* ── Unacknowledged handover banner ── *@
    @if (Model.PendingHandovers.Any())
    {
        <div style="background:#fffbeb;border:1.5px solid #fcd34d;border-radius:10px;overflow:hidden;margin-bottom:14px">
            <div style="padding:12px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
                <div style="display:flex;align-items:center;gap:10px">
                    <span style="font-size:18px">&#9888;</span>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:#92400e">
                            @Model.PendingHandovers.Count unacknowledged handover@(Model.PendingHandovers.Count == 1 ? "" : "s")
                        </div>
                        <div style="font-size:11px;color:#b45309">Incoming TL sign-off has not been received</div>
                    </div>
                </div>
                <button onclick="document.getElementById('pendingList').style.display=document.getElementById('pendingList').style.display==='none'?'block':'none'"
                        class="sbtn sm" style="border-color:#fcd34d;color:#92400e">
                    Show details
                </button>
            </div>
            <div id="pendingList" style="display:none;border-top:1px solid #fcd34d">
                <table class="dash-table" style="margin:0">
                    <thead>
                        <tr>
                            <th>Area</th>
                            <th>Shift</th>
                            <th>Date</th>
                            <th>Outgoing TL</th>
                            <th>Waiting</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.PendingHandovers)
                        {
                            <tr>
                                <td style="font-weight:600">@p.Area</td>
                                <td>@p.Shift</td>
                                <td>@p.ShiftDate.ToString("dd/MM/yyyy")</td>
                                <td>@p.OutgoingTLSignature</td>
                                <td style="color:#b45309;font-weight:600">
                                    @{
                                        var t = p.WaitingFor;
                                        var age = t.TotalMinutes < 60 ? $"{(int)t.TotalMinutes}m"
                                                : t.TotalHours < 24 ? $"{(int)t.TotalHours}h {t.Minutes}m"
                                                : $"{(int)t.TotalDays}d {t.Hours}h";
                                    }
                                    @age
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!Model.Shifts.Any())
    {
        <div class="card"><div class="empty">No shifts recorded today yet.</div></div>
    }
    else
    {
        foreach (var s in Model.Shifts)
        {
            <div class="card">
                <div class="card-head">
                    <span class="card-title">@s.Shift shift — Area @(s.Area ?? "?")</span>
                    <a class="edit-btn" asp-page="/Form" asp-route-id="@s.Id">Edit this shift</a>
                </div>
                <div class="meta-row">
                    <div class="meta-item"><div class="meta-label">Team leader</div><div class="meta-val">@s.TeamLeaderDisplay</div></div>
                    <div class="meta-item"><div class="meta-label">Hours completed</div><div class="meta-val">@s.HoursCompleted</div></div>
                    <div class="meta-item"><div class="meta-label">Submitted</div><div class="meta-val">@s.SubmittedAt.ToLocalTime().ToString("HH:mm")</div></div>
                    @if (s.LastEditedBy != null)
                    {
                        <div class="meta-item">
                            <div class="meta-label">Last edited by</div>
                            <div class="meta-val">@s.LastEditedBy at @s.LastEditedAt?.ToLocalTime().ToString("HH:mm")</div>
                        </div>
                    }
                </div>
                <div style="display:flex;gap:8px;padding:12px 18px;border-bottom:1px solid var(--border)">
                    <div style="flex:1;text-align:center;padding:8px;border:1px solid var(--border);border-radius:6px">
                        <div class="meta-label" style="margin-bottom:4px">Safety</div>
                        <span class="rv @TodayModel.Rc(s.SafetyStatus)">@(s.SafetyStatus ?? "—")</span>
                    </div>
                    <div style="flex:1;text-align:center;padding:8px;border:1px solid var(--border);border-radius:6px">
                        <div class="meta-label" style="margin-bottom:4px">Quality</div>
                        <span class="rv @TodayModel.Rc(s.QualityStatus)">@(s.QualityStatus ?? "—")</span>
                    </div>
                    <div style="flex:1;text-align:center;padding:8px;border:1px solid var(--border);border-radius:6px">
                        <div class="meta-label" style="margin-bottom:4px">Performance</div>
                        <span class="rv @TodayModel.Rc(s.PerfStatus)">@(s.PerfStatus ?? "—")</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(s.Escalations))
                {
                    <div class="escl-banner">&#9888; @s.Escalations</div>
                }
                <div style="padding:10px 18px">
                    <a href="/api/submissions/@s.Id/pdf" class="dl-link pdf-dl" data-filename="@($"TLSW_{s.ShiftDate:yyyyMMdd}.pdf")">&#8595; Download PDF</a>
                </div>
            </div>
        }
    }
</div>
