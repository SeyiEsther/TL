@inject TL.Services.PersonListService PersonList
@{
    var owners = PersonList.ActionOwnersList;
}
<div class="card" style="margin-bottom:14px">
    <div class="card-head">
        <span class="card-title">Assign actions</span>
        <span class="card-sub">Owned follow-ups — each goes to that person's action list</span>
    </div>
    <div class="aa-wrap">
        <div class="aa-head">
            <span>Owner</span>
            <span>Action</span>
            <span>Due (optional)</span>
            <span></span>
        </div>
        <div id="aa-rows"></div>
        <button type="button" class="sbtn sm" id="aa-add" style="margin-top:4px">&#65291; Add action</button>
        <input type="hidden" name="NewActionsJson" id="aa-json">
    </div>
</div>

<template id="aa-row-tpl">
    <div class="aa-row">
        <div class="aa-owner-wrap">
            <select class="ff-input aa-owner">
                <option value="">Select owner…</option>
                @foreach (var o in owners)
                {
                    var ext = TL.Models.ActionOwners.IsExternal(o);
                    <option value="@o">@o@(ext ? " — shared" : "")</option>
                }
                <option value="__other__">Other (type a name)…</option>
            </select>
            <input type="text" class="ff-input aa-other" placeholder="Type owner name…" style="display:none;margin-top:6px">
        </div>
        <input type="text" class="ff-input aa-text" placeholder="What needs doing…">
        <input type="date" class="ff-input aa-due">
        <button type="button" class="aa-del" title="Remove row">&times;</button>
    </div>
</template>

<style>
    .aa-wrap { padding: 14px 16px; }
    .aa-head, .aa-row {
        display: grid;
        grid-template-columns: minmax(180px, 1.2fr) minmax(200px, 2fr) 150px 34px;
        gap: 10px; align-items: start;
    }
    .aa-head { padding: 0 2px 6px; }
    .aa-head span {
        font-size: 10px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .04em; color: var(--muted);
    }
    .aa-row { margin-bottom: 10px; }
    .aa-wrap .ff-input { width: 100%; }
    .aa-del {
        height: 34px; width: 34px; border: 1px solid var(--border); border-radius: 8px;
        background: #fff; color: #CC1F2C; font-size: 18px; line-height: 1; cursor: pointer;
    }
    .aa-del:hover { background: #fef2f2; border-color: #fca5a5; }
    @@media (max-width: 720px) {
        .aa-head { display: none; }
        .aa-row { grid-template-columns: 1fr 34px; grid-template-areas: "owner del" "text del" "due del"; }
        .aa-owner-wrap { grid-area: owner; } .aa-text { grid-area: text; }
        .aa-due { grid-area: due; } .aa-del { grid-area: del; align-self: start; }
    }
</style>

<script>
(function () {
    'use strict';
    var body = document.getElementById('aa-rows');
    var tpl = document.getElementById('aa-row-tpl');
    var json = document.getElementById('aa-json');
    if (!body || !tpl || !json) return;
    var form = json.closest('form');

    function ownerOf(row) {
        var sel = row.querySelector('.aa-owner');
        var other = row.querySelector('.aa-other');
        if (sel.value === '__other__') return (other.value || '').trim();
        return sel.value.trim();
    }

    function sync() {
        var rows = [];
        body.querySelectorAll('.aa-row').forEach(function (row) {
            var owner = ownerOf(row);
            var text = row.querySelector('.aa-text').value.trim();
            var due = row.querySelector('.aa-due').value;
            if (owner && text) rows.push({ owner: owner, text: text, due: due });
        });
        json.value = rows.length ? JSON.stringify(rows) : '';
    }

    function addRow() {
        body.appendChild(tpl.content.cloneNode(true));
        sync();
    }

    document.getElementById('aa-add').addEventListener('click', addRow);
    body.addEventListener('input', sync);
    body.addEventListener('change', function (e) {
        // Toggle the free-text "Other" name box.
        if (e.target.classList.contains('aa-owner')) {
            var other = e.target.closest('.aa-row').querySelector('.aa-other');
            var isOther = e.target.value === '__other__';
            other.style.display = isOther ? '' : 'none';
            if (isOther) other.focus(); else other.value = '';
        }
        sync();
    });
    body.addEventListener('click', function (e) {
        if (e.target.classList.contains('aa-del')) {
            e.target.closest('.aa-row').remove();
            sync();
        }
    });
    if (form) form.addEventListener('submit', sync);
})();
</script>
