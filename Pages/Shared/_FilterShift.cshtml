@model FilterDropdownModel
@{
    var id = $"fs-{Model.Name}";
    var options = new[] {
        ("", "All", "grid"),
        ("Day", "Day", "sun"),
        ("Afternoon", "Afternoon", "sunset"),
        ("Night", "Night", "moon")
    };
    var current = Model.Value ?? "";
    var display = string.IsNullOrEmpty(current)
        ? Model.Placeholder
        : (options.FirstOrDefault(o => o.Item1 == current).Item2 ?? current);
}
<div class="fs fs-shift" id="@id" data-name="@Model.Name" data-placeholder="@Model.Placeholder">
    <span class="fs-label">@Model.Label</span>
    <button type="button" class="fs-trigger" aria-haspopup="listbox" aria-expanded="false">
        <svg class="fs-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
        </svg>
        <span class="fs-display @(string.IsNullOrEmpty(current) ? "fs-placeholder" : "")">@display</span>
        <svg class="fs-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <input type="hidden" name="@Model.Name" value="@current" class="fs-input">
    <div class="fs-popover" aria-hidden="true" role="listbox">
        <div class="fs-quick fs-quick-4">
            @foreach (var (val, label, icon) in options)
            {
                <button type="button" class="fs-quick-btn @(current == val ? "active" : "")" data-value="@val" role="option">
                    @if (icon == "sun") {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                    } else if (icon == "sunset") {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 18a5 5 0 0 0-10 0"/><path d="M12 9V2M4.22 10.22l1.42 1.42M18.36 10.22l1.42-1.42"/></svg>
                    } else if (icon == "moon") {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                    } else {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    }
                    <span>@label</span>
                </button>
            }
        </div>
    </div>
</div>
