@page
@model SeniorRotaModel
@{ ViewData["Title"] = "Senior Audit Rota"; }

<div class="wrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title">Senior audit rota — @Model.Year</div>
            <div class="page-sub">Group 1s &amp; Directors, split into @SeniorRota.GroupCountFor(Model.SeniorNames) teams of @SeniorRota.GroupSize — one team on duty each week for the Senior Weekly Audit. Teams re-draw automatically every January.</div>
        </div>
        <a asp-page="/SeniorDashboard" class="sbtn sm">Back to dashboard</a>
    </div>

    @if (Model.ThisWeek is { } tw)
    {
        <div class="card" style="margin-bottom:20px;overflow:hidden;border:none">
            <div style="background:linear-gradient(135deg,#1e2a4a,#2B5AED 65%,#3b6bf5);padding:22px 26px">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px">
                    <div>
                        <div style="font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.72);font-weight:700;margin-bottom:2px">
                            On duty now &bull; Week @tw.IsoWeek &bull; @tw.WeekStart.ToString("dd MMM") &ndash; @tw.WeekEnd.ToString("dd MMM")
                        </div>
                        <div style="font-size:23px;font-weight:800;color:#fff">Team @tw.TeamNumber</div>
                    </div>
                    <a asp-page="/SeniorStart" asp-route-date="@tw.WeekStart.ToString("yyyy-MM-dd")"
                       class="sbtn primary" style="background:#fff;color:#1e2a4a;border:none;font-weight:700;white-space:nowrap">
                        Start this week's audit &rarr;
                    </a>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px">
                    @foreach (var person in tw.Team)
                    {
                        <div style="display:flex;align-items:center;gap:9px;background:rgba(255,255,255,.12);border-radius:10px;padding:8px 12px">
                            <div style="width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.9);color:#1e2a4a;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex-shrink:0">
                                @SeniorRota.Initials(person)
                            </div>
                            <span style="font-size:12px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@person</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @foreach (var month in Model.Months)
    {
        <div style="margin-bottom:24px">
            <div style="font-size:12px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:10px;padding-left:2px">
                @month.Key
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px">
                @foreach (var w in month)
                {
                    var isPastCls = w.IsPast ? "opacity:.55;" : "";
                    var borderCls = w.IsCurrent
                        ? "border:2px solid var(--accent);box-shadow:0 6px 20px rgba(43,90,237,.18);"
                        : "border:1px solid var(--border);";
                    <div class="card" style="@borderCls @isPastCls padding:14px 16px;display:flex;flex-direction:column;gap:12px;margin-bottom:0">
                        <div style="display:flex;align-items:center;gap:8px">
                            <div style="font-size:13px;font-weight:800;color:var(--accent)">Team @w.TeamNumber</div>
                            <div style="font-size:10px;color:var(--muted)">Wk @w.IsoWeek &bull; @w.WeekStart.ToString("dd MMM") &ndash; @w.WeekEnd.ToString("dd MMM")</div>
                            @if (w.IsCurrent)
                            {
                                <span style="margin-left:auto;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--accent);background:var(--accent-soft);padding:3px 7px;border-radius:20px;white-space:nowrap">Now</span>
                            }
                        </div>
                        <div style="display:flex;flex-direction:column;gap:7px">
                            @foreach (var person in w.Team)
                            {
                                <div style="display:flex;align-items:center;gap:9px">
                                    <div style="width:26px;height:26px;border-radius:50%;background:@SeniorRota.AvatarColor(person, Model.SeniorNames);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0">
                                        @SeniorRota.Initials(person)
                                    </div>
                                    <span style="font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@person</span>
                                </div>
                            }
                        </div>
                        <a asp-page="/SeniorStart" asp-route-date="@w.WeekStart.ToString("yyyy-MM-dd")"
                           class="sbtn @(w.IsCurrent ? "primary" : "") sm" style="text-align:center">
                            Start audit
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>
