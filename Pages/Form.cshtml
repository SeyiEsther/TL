@page
@model FormModel
@using TL.Models
@{
    ViewData["Title"] = "Hourly Check";
    var H = Model.Hours;
    HourInput hd(int i) => i < Model.H.Count ? Model.H[i] : new HourInput();
}

<div class="page">

    <div class="session-bar">
        <div class="sf"><label>Date</label><input type="text" value="@Model.ShiftDate" readonly></div>
        <div class="sf"><label>Shift</label><input type="text" value="@Model.Shift" readonly></div>
        <div class="sf">
            <label>Team leader</label>
            <input type="text" value="@Model.TeamLeader" readonly>
            @if (!string.IsNullOrWhiteSpace(Model.CoveringFor))
            {
                <div style="font-size:10px;color:var(--muted);margin-top:3px">covering for <strong>@Model.CoveringFor</strong></div>
            }
        </div>
        <div class="sf">
            <label>Area</label>
            <input type="text" value="@Model.Area" readonly style="font-weight:700;color:var(--red)">
            @{ var areaMachines = AreaList.GetMachines(Model.Area); }
            @if (!string.IsNullOrEmpty(areaMachines))
            {
                <div style="font-size:10px;color:var(--muted);margin-top:3px;line-height:1.4">@areaMachines</div>
            }
        </div>

        <div class="sf" style="margin-left:auto">
            <label>Hours in shift</label>
            <form method="get" style="display:flex;gap:6px;align-items:center">
                <input type="hidden" name="date" value="@Model.ShiftDate">
                <input type="hidden" name="shift" value="@Model.Shift">
                <input type="hidden" name="area" value="@Model.Area">
                <input type="hidden" name="tl" value="@Model.TeamLeader">
                @if (Model.EditingId.HasValue)
                {
                    <input type="hidden" name="id" value="@Model.EditingId">
                }
                <select name="hours">
                    @for (int h = 8; h >= 1; h--)
                    {
                        <option value="@h" selected="@(Model.Hours == h ? "selected" : null)">@h hrs</option>
                    }
                </select>
                <button type="submit" class="sbtn sm">Set</button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SaveMessage))
    {
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:10px 16px;margin-bottom:14px;font-size:12px;color:#166534">
            @Model.SaveMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ValidationError))
    {
        <div class="err" style="margin-bottom:14px">@Model.ValidationError</div>
    }

    <div id="shift-progress-bar" style="background:var(--white);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <span style="font-size:12px;font-weight:700">Progress</span>
            <span id="shift-progress-text" style="font-size:12px;color:var(--muted)">0 of @(H + 2)</span>
        </div>
        <div style="height:8px;background:#e5e7eb;border-radius:4px;overflow:hidden">
            <div id="shift-progress-fill" style="height:100%;width:0;background:#16a34a;transition:width .2s"></div>
        </div>
    </div>

    <form method="post" id="shift-form" data-shift-form data-hours="@H" data-editing-id="@(Model.EditingId?.ToString() ?? "")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ShiftDate" value="@Model.ShiftDate">
        <input type="hidden" name="Shift" value="@Model.Shift">
        <input type="hidden" name="TeamLeader" value="@Model.TeamLeader">
        <input type="hidden" name="Area" value="@Model.Area">
        <input type="hidden" name="CoveringFor" value="@Model.CoveringFor">
        <input type="hidden" name="HoursCount" value="@H">
        <input type="hidden" name="EditingId" value="@(Model.EditingId?.ToString() ?? "")">

        <div class="grid-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="qcol">Question</th>
                        @for (int h = 0; h < H; h++)
                        {
                            <th class="hcol">Hr <span class="hnum">@(h + 1)</span></th>
                        }
                    </tr>
                </thead>
                <tbody>

                    <tr class="sec-row safety"><td class="acc"></td><td colspan="@H">Health &amp; Safety</td></tr>
                    @{ await RenderYN("Any hazards observed?", "Haz", h => hd(h).Haz,
                        "Slips, trips, blocked exits or unsafe conditions anywhere in the area"); }
                    @{ await RenderYN("Any unsafe behaviours observed?", "Uns", h => hd(h).Uns,
                        "Anyone working unsafely — missing PPE, bypassing guards or taking shortcuts"); }
                    @{ await RenderYN("Any positive behaviours praised?", "Pos", h => hd(h).Pos,
                        "Proactive safety actions worth calling out and sharing with the team"); }
                    @{ await RenderNote("Description", "Snote", h => hd(h).Snote); }

                    <tr class="sec-row quality"><td class="acc"></td><td colspan="@H">Quality</td></tr>
                    @{ await RenderYN("All quality checks completed?", "Qchk", h => hd(h).Qchk,
                        "All scheduled inspections and verification checks were carried out this hour"); }
                    @{ await RenderYN("Any deviations escalated?", "Dev", h => hd(h).Dev,
                        "Any deviation from spec or process has been raised with the relevant team"); }
                    @{ await RenderYN("Any non-compliance addressed?", "Nc", h => hd(h).Nc,
                        "Any instance of non-compliance was identified and acted on"); }
                    @{ await RenderYN("Do the tools match the inspection plan?", "Qiplan", h => hd(h).Qiplan,
                        "No non-conforming tools e.g. tape measure"); }
                    @{ await RenderNote("Description", "Qnote", h => hd(h).Qnote); }

                    <tr class="sec-row perf"><td class="acc"></td><td colspan="@H">Performance</td></tr>
                    @{ await RenderYN("Hourly target achieved?", "Tgt", h => hd(h).Tgt,
                        "Output met the planned production target for this hour"); }
                    @{ await RenderYN("Any maintenance issues reported?", "Maint", h => hd(h).Maint,
                        "Equipment faults or breakdowns have been logged with maintenance"); }
                    @{ await RenderYN("All materials available for next hour?", "Mat", h => hd(h).Mat,
                        "Raw materials, components and consumables are in place for the next hour"); }
                    @{ await RenderYN("All tools available?", "Tools", h => hd(h).Tools,
                        "All required tools and equipment are present and in working order"); }
                    @{ await RenderYN("Any escalations needed?", "Escl", h => hd(h).Escl,
                        "Issues that need action from another team or a senior level"); }
                    @{ await RenderYN("All parts confirmed?", "Pconf", h => hd(h).Pconf,
                        "Parts count matches the production order for this hour"); }
                    @{ await RenderYN("All parts ID'd properly?", "Pid", h => hd(h).Pid,
                        "Covers ALL parts and stock in the surrounding area — not just the part currently on the machine. Check every bin, label and WIP in the vicinity.",
                        warn: true); }
                    @{ await RenderYN("All NC parts ID'd &amp; stored correctly?", "Ncp", h => hd(h).Ncp,
                        "Non-conforming parts are clearly labelled and moved to the dedicated NC zone"); }
                    @{ await RenderNote("Actions taken", "Pnote", h => hd(h).Pnote); }

                    <tr class="sec-row morale"><td class="acc"></td><td colspan="@H">Morale Check</td></tr>
                    @{ await RenderYN("Operator wellbeing confirmed?", "Wb", h => hd(h).Wb,
                        "Checked in with each team member — everyone is fit, comfortable and not struggling"); }
                    @{ await RenderYN("Does operator require support?", "Sup", h => hd(h).Sup,
                        "Anyone raising a concern, finding it difficult or asking for additional help"); }
                    @{ await RenderNote("Detail support required", "Mnote", h => hd(h).Mnote); }

                    <tr class="sec-row final"><td class="acc"></td><td colspan="@H">Final Shift Status</td></tr>
                    @{ await RenderYN("Any accidents reported this shift?", "Acc", h => hd(h).Acc,
                        "Any RTA, near-miss or first-aid incident recorded in the accident book this shift"); }
                    @{ await RenderStatus("Overall safety status", "Ss", h => hd(h).Ss); }
                    @{ await RenderStatus("Overall quality status", "Qs", h => hd(h).Qs); }
                    @{ await RenderStatus("Overall performance status", "Ps", h => hd(h).Ps); }

                </tbody>
            </table>
        </div>

        <div class="shift-once-card">
            <div class="shift-once-head">End-of-shift activities</div>
            <div class="shift-once-body">
                @{ var sixsVal = Model.H.Count > 0 ? Model.H[0].Sixs : null; }
                @{ var tpmVal  = Model.H.Count > 0 ? Model.H[0].Tpm  : null; }
                <div class="shift-once-q">
                    <div class="shift-once-label">6S activities completed?</div>
                    <div class="audit-yn">
                        <input type="radio" class="ayn-y" name="H[0].Sixs" id="sixs_y" value="True"  checked="@(sixsVal == true  ? "checked" : null)">
                        <label for="sixs_y">Yes</label>
                        <input type="radio" class="ayn-n" name="H[0].Sixs" id="sixs_n" value="False" checked="@(sixsVal == false ? "checked" : null)">
                        <label for="sixs_n">No</label>
                    </div>
                </div>
                <div class="shift-once-q">
                    <div class="shift-once-label">TPM activities completed?</div>
                    <div class="audit-yn">
                        <input type="radio" class="ayn-y" name="H[0].Tpm" id="tpm_y" value="True"  checked="@(tpmVal == true  ? "checked" : null)">
                        <label for="tpm_y">Yes</label>
                        <input type="radio" class="ayn-n" name="H[0].Tpm" id="tpm_n" value="False" checked="@(tpmVal == false ? "checked" : null)">
                        <label for="tpm_n">No</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="summary-grid">
            <h3>Shift summary &amp; handover</h3>
            <div class="sfield full">
                <label>Escalations / outstanding issues</label>
                <textarea name="Escalations" placeholder="Notes…">@Model.Escalations</textarea>
            </div>
            <div class="sfield">
                <label>Key risks for next shift</label>
                <textarea name="KeyRisks" placeholder="Notes…">@Model.KeyRisks</textarea>
            </div>
            <div class="sfield">
                <label>Immediate priorities for incoming team</label>
                <textarea name="Priorities" placeholder="Notes…">@Model.Priorities</textarea>
            </div>
        </div>

        <div style="background:var(--white);border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:14px">
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:700;padding-bottom:10px;border-bottom:1px solid var(--border);margin-bottom:14px">Outgoing TL sign-off</div>
            <div class="sfield full">
                <label>Sign-off (full name)</label>
                <input type="text" name="OutgoingTLSignature" value="@Model.OutgoingTLSignature"
                       placeholder="Full name…" required
                       style="padding:10px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;font-family:inherit;color:var(--ink);max-width:400px">
            </div>
        </div>

        <div class="submit-bar">
            <button type="button" class="sbtn primary" id="shift-submit-btn">
                Save progress
            </button>
            <button type="button" class="sbtn primary" id="shift-final-btn">
                Submit &amp; close shift
            </button>
            <a asp-page="/Index" class="sbtn">Cancel</a>
            <span id="save-status" style="font-size:11px;color:var(--muted);margin-left:10px"></span>
        </div>
    </form>
</div>

<script>
(function () {
    const form = document.getElementById('shift-form') || document.querySelector('form[method="post"]');
    if (!form) return;

    const statusEl = document.getElementById('save-status');
    const progressBtn = document.getElementById('shift-submit-btn');
    const progressText = document.getElementById('shift-progress-text');
    const progressFill = document.getElementById('shift-progress-fill');
    const hoursCount = parseInt(form?.dataset.hours || '@H', 10);

    const hourFields = ['Haz','Uns','Pos','Qchk','Dev','Nc','Qiplan','Tgt','Maint','Mat','Tools','Escl','Pconf','Pid','Ncp','Wb','Sup','Acc'];
    const statusFields = ['Ss','Qs','Ps'];

    function radioGroupAnswered(name) {
        const radios = form.querySelectorAll(`input[name="${name}"]`);
        return radios.length === 0 || Array.from(radios).some(r => r.checked);
    }

    function hourComplete(h) {
        for (const f of hourFields) {
            const radios = form.querySelectorAll(`input[name="H[${h}].${f}"]`);
            if (radios.length && !Array.from(radios).some(r => r.checked)) return false;
        }
        for (const f of statusFields) {
            const radios = form.querySelectorAll(`input[name="H[${h}].${f}"]`);
            if (radios.length && !Array.from(radios).some(r => r.checked)) return false;
        }
        return true;
    }

    function endShiftComplete() {
        return radioGroupAnswered('H[0].Sixs') && radioGroupAnswered('H[0].Tpm');
    }

    function initRadioDeselect(root) {
        root.querySelectorAll('.yn-group label, .status-group label, .shift-once-body .audit-yn label').forEach(function (label) {
            label.addEventListener('mousedown', function (e) {
                var id = label.getAttribute('for');
                var input = id ? document.getElementById(id) : null;
                if (input && input.type === 'radio' && input.checked) {
                    e.preventDefault();
                    setTimeout(function () {
                        input.checked = false;
                        input.dispatchEvent(new Event('change', { bubbles: true }));
                    }, 0);
                }
            });
        });
    }

    initRadioDeselect(form);

    function updateCompletion() {
        let complete = 0;
        const total = hoursCount + 2;
        for (let h = 0; h < hoursCount; h++) {
            if (hourComplete(h)) complete++;
        }
        if (radioGroupAnswered('H[0].Sixs')) complete++;
        if (radioGroupAnswered('H[0].Tpm')) complete++;
        if (progressText) progressText.textContent = complete + ' of ' + total;
        if (progressFill) progressFill.style.width = (total ? Math.round(complete / total * 100) : 0) + '%';
    }

    let dirty = false;

    form?.addEventListener('change', function (e) {
        updateCompletion();
        dirty = true;
        const hourMatch = e.target?.name?.match(/^H\[(\d+)\]/);
        if (hourMatch) {
            // Save the whole hour immediately once it's complete, otherwise
            // debounce-save the partial progress so nothing is left only in the browser.
            const h = parseInt(hourMatch[1], 10);
            if (hourComplete(h)) saveToServer('hour');
            else scheduleServerSave();
            return;
        }
        scheduleServerSave();
    });
    form?.addEventListener('input', function (e) {
        updateCompletion();
        dirty = true;
        scheduleServerSave();
    });
    updateCompletion();

    let serverSaveTimer = null;
    let saveChain = Promise.resolve();

    function saveToServer(reason) {
        const job = async () => {
            if (!form) return;
            if (progressBtn) progressBtn.disabled = true;
            try {
                ensureEditingIdInput();
                const formData = new FormData(form);
                const token = form.querySelector('[name="__RequestVerificationToken"]')?.value;
                const pageId = new URLSearchParams(location.search).get('id')
                    || form.dataset.editingId
                    || form.querySelector('input[name="EditingId"]')?.value;
                const saveUrl = pageId ? `?handler=SaveProgress&id=${pageId}` : '?handler=SaveProgress';
                const resp = await fetch(saveUrl, {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'RequestVerificationToken': token || '',
                        'X-CSRF-TOKEN': token || ''
                    }
                });
                const saveText = await resp.text();
                let data;
                try { data = JSON.parse(saveText); } catch (e) {
                    if (!resp.ok) {
                        throw new Error('Server returned ' + resp.status + (saveText ? ': ' + saveText.slice(0, 120) : ''));
                    }
                    throw new Error('Unexpected server response — try again in a moment');
                }
                if (!resp.ok) {
                    throw new Error(data.error || data.message || ('Server returned ' + resp.status));
                }
                dirty = false;
                if (data.id) {
                    ensureEditingIdInput().value = data.id;
                    form.dataset.editingId = String(data.id);
                    const url = new URL(location.href);
                    if (url.searchParams.get('id') !== String(data.id)) {
                        url.searchParams.set('id', data.id);
                        history.replaceState(null, '', url);
                    }
                }
                if (reason === 'leave') return;
                const t = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const label = data.hoursMerged > 0
                    ? (reason === 'hour' ? 'Hour saved' : 'Saved')
                    : 'Connected (fill an hour to save data)';
                statusEl.textContent = label + ' to server at ' + t;
            } catch (e) {
                if (reason !== 'leave') {
                    statusEl.textContent = e.message || 'Could not save to server — try Save progress again';
                }
                throw e;
            } finally {
                if (progressBtn) progressBtn.disabled = false;
            }
        };
        saveChain = saveChain.then(job, job);
        return saveChain;
    }

    function ensureEditingIdInput() {
        let idInput = form.querySelector('input[name="EditingId"]');
        if (!idInput) {
            idInput = document.createElement('input');
            idInput.type = 'hidden';
            idInput.name = 'EditingId';
            form.appendChild(idInput);
        }
        if (!idInput.value) {
            const fromDataset = form.dataset.editingId;
            const fromUrl = new URLSearchParams(location.search).get('id');
            if (fromDataset) idInput.value = fromDataset;
            else if (fromUrl) idInput.value = fromUrl;
        }
        return idInput;
    }

    function scheduleServerSave() {
        clearTimeout(serverSaveTimer);
        serverSaveTimer = setTimeout(() => saveToServer('auto'), 3000);
    }

    progressBtn?.addEventListener('click', function () {
        saveToServer('manual');
    });

    const finalBtn = document.getElementById('shift-final-btn');
    finalBtn?.addEventListener('click', async function () {
        const sigInput = form.querySelector('input[name="OutgoingTLSignature"]');
        if (sigInput && !sigInput.value.trim()) {
            sigInput.focus();
            sigInput.setCustomValidity('Please enter your full name to sign off the shift.');
            sigInput.reportValidity();
            return;
        }
        if (sigInput) sigInput.setCustomValidity('');

        finalBtn.disabled = true;
        if (statusEl) statusEl.textContent = 'Submitting…';
        try {
            clearTimeout(serverSaveTimer);
            // Finish any in-flight autosave before close so we don't race last-write-wins.
            try { await saveChain; } catch (_) { /* continue with submit */ }
            dirty = false;
            ensureEditingIdInput();
            const formData = new FormData(form);
            const token = form.querySelector('[name="__RequestVerificationToken"]')?.value;
            const pageId = new URLSearchParams(location.search).get('id')
                || form.dataset.editingId
                || form.querySelector('input[name="EditingId"]')?.value;
            const submitUrl = pageId ? `/Form?id=${pageId}` : '/Form';
            const resp = await fetch(submitUrl, {
                method: 'POST',
                body: formData,
                credentials: 'same-origin',
                headers: {
                    'Accept': 'application/json',
                    'RequestVerificationToken': token || '',
                    'X-CSRF-TOKEN': token || '',
                }
            });
            const text = await resp.text();
            let data;
            try { data = JSON.parse(text); } catch (_) { data = {}; }
            if (data.redirect) {
                dirty = false;
                location.href = data.redirect;
                return;
            }
            if (statusEl) statusEl.textContent = data.error || 'Could not submit — please try again.';
        } catch (e) {
            if (statusEl) statusEl.textContent = e.message || 'Could not submit — check your connection and try again.';
        } finally {
            finalBtn.disabled = false;
        }
    });

    function isHomeNavigation(href) {
        if (!href || href.startsWith('#')) return false;
        try {
            const url = new URL(href, location.origin);
            if (url.origin !== location.origin) return false;
            const path = url.pathname.replace(/\/$/, '') || '/';
            return path === '' || path === '/' || /\/Index$/i.test(path);
        } catch (e) {
            return false;
        }
    }

    document.addEventListener('click', function (e) {
        const a = e.target.closest && e.target.closest('a[href]');
        if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (!isHomeNavigation(a.getAttribute('href'))) return;
        e.preventDefault();
        clearTimeout(serverSaveTimer);
        const go = () => { location.href = a.href; };
        saveToServer('leave').then(go, go);
    }, true);

    // Last-resort flush for the exits saveToServer('leave') can't catch: closing the
    // tab, the browser Back button, navigating elsewhere, or the phone/laptop sleeping.
    // sendBeacon posts the full form (including the antiforgery token field) so the
    // server-side Save progress handler persists whatever is on screen.
    function flushOnLeave() {
        if (!form || !dirty || !navigator.sendBeacon) return;
        try {
            ensureEditingIdInput();
            const formData = new FormData(form);
            const pageId = new URLSearchParams(location.search).get('id')
                || form.dataset.editingId
                || form.querySelector('input[name="EditingId"]')?.value;
            const saveUrl = pageId ? `?handler=SaveProgress&id=${pageId}` : '?handler=SaveProgress';
            if (navigator.sendBeacon(saveUrl, formData)) dirty = false;
        } catch (e) { /* nothing more we can do as the page unloads */ }
    }

    window.addEventListener('pagehide', flushOnLeave);
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') flushOnLeave();
    });
})();
</script>

@functions {
    async Task RenderYN(string label, string field, Func<int, bool?> val, string? hint = null, bool warn = false)
    {
        <tr class="dr">
            <td class="ql">
                @Html.Raw(label)
                @if (hint != null)
                {
                    <div class="@(warn ? "q-hint q-hint-warn" : "q-hint")">@hint</div>
                }
            </td>
            @for (int h = 0; h < Model.Hours; h++)
            {
                var v = val(h);
                var yId = $"h{h}_{field}_y";
                var nId = $"h{h}_{field}_n";
                var name = $"H[{h}].{field}";
                <td class="cell">
                    <div class="yn-group">
                        <input type="radio" class="yn-y" name="@name" id="@yId" value="True" checked="@(v == true ? "checked" : null)">
                        <label for="@yId">Y</label>
                        <input type="radio" class="yn-n" name="@name" id="@nId" value="False" checked="@(v == false ? "checked" : null)">
                        <label for="@nId">N</label>
                    </div>
                </td>
            }
        </tr>
        await Task.CompletedTask;
    }

    async Task RenderNote(string label, string field, Func<int, string?> val)
    {
        <tr class="nr">
            <td class="ql">@label</td>
            @for (int h = 0; h < Model.Hours; h++)
            {
                var name = $"H[{h}].{field}";
                <td class="nc">
                    <textarea name="@name" placeholder="Notes…">@val(h)</textarea>
                </td>
            }
        </tr>
        await Task.CompletedTask;
    }

    async Task RenderStatus(string label, string field, Func<int, string?> val)
    {
        <tr class="dr">
            <td class="ql">@label</td>
            @for (int h = 0; h < Model.Hours; h++)
            {
                var v = val(h) ?? "";
                var name = $"H[{h}].{field}";
                var gId = $"h{h}_{field}_g";
                var aId = $"h{h}_{field}_a";
                var rId = $"h{h}_{field}_r";
                <td class="cell">
                    <div class="status-group">
                        <input type="radio" class="st-g" name="@name" id="@gId" value="Green" checked="@(v == "Green" ? "checked" : null)">
                        <label for="@gId">G</label>
                        <input type="radio" class="st-a" name="@name" id="@aId" value="Amber" checked="@(v == "Amber" ? "checked" : null)">
                        <label for="@aId">A</label>
                        <input type="radio" class="st-r" name="@name" id="@rId" value="Red" checked="@(v == "Red" ? "checked" : null)">
                        <label for="@rId">R</label>
                    </div>
                </td>
            }
        </tr>
        await Task.CompletedTask;
    }
}
