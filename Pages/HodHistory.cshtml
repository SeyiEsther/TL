@page
@model HodHistoryModel
@{ ViewData["Title"] = "HoD audit history"; }

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">HoD audit history</div>
            <div class="page-sub">@Model.Rows.Count audit@(Model.Rows.Count == 1 ? "" : "s")</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a asp-page="/AuditStart" class="sbtn primary sm">+ New audit</a>
            <a asp-page="/HodDashboard" class="sbtn sm">HoD dashboard</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="card" style="margin-bottom:14px;padding:12px 16px;font-size:13px;color:#16a34a;background:#f0fdf4;border-color:#bbf7d0">
            @Model.StatusMessage
        </div>
    }

    <div class="card card-filter" style="margin-bottom:14px">
        <form method="get" class="filters">
            <partial name="_DatePicker" model='new DatePickerModel("from", Model.From, "From")' />
            <partial name="_DatePicker" model='new DatePickerModel("to", Model.To, "To")' />
            <partial name="_FilterArea" model='new FilterDropdownModel("area", "Area", Model.AreaFilter, "All areas")' />
            <div class="ff">
                <span class="ff-label">Auditor</span>
                <div class="ff-control">
                    <svg class="ff-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" name="q" class="ff-input" value="@Model.PersonFilter" placeholder="Search auditor…" style="min-width:180px">
                </div>
            </div>
            <div class="filter-actions">
                <button type="submit" class="sbtn sm filter-apply">Apply filters</button>
                <a asp-page="/HodHistory" class="sbtn sm">Clear</a>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="card-head">
            <span class="card-title">HoD / Shift Manager audits</span>
            <span class="card-sub">@Model.Rows.Count record@(Model.Rows.Count == 1 ? "" : "s")</span>
        </div>
        @if (!Model.Rows.Any())
        {
            <div class="empty">No HoD audits found for the selected filters.</div>
        }
        else
        {
            <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
                <table class="dash-table" style="min-width:960px">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Department</th>
                            <th>Area</th>
                            <th>Auditor</th>
                            <th>Rating / Score</th>
                            <th>Flags</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td>@r.Date.ToString("dd/MM/yyyy")</td>
                                <td style="font-weight:600">@r.AuditType</td>
                                <td>@r.Department</td>
                                <td style="font-weight:600">@r.Area</td>
                                <td>@r.Auditor</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(r.Rating))
                                    {
                                        <span class="rag @HistoryListService.Rc(r.Rating)">@r.Rating</span>
                                        @if (r.ScorePct.HasValue)
                                        {
                                            <span style="margin-left:6px;font-weight:700">@r.ScorePct%</span>
                                        }
                                    }
                                    else if (r.IsLegacy)
                                    {
                                        <span style="font-size:11px;color:var(--muted)">Legacy</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--muted)">—</span>
                                    }
                                </td>
                                <td style="font-size:11px">
                                    @if (r.HasActions) { <span style="color:#b45309;font-weight:600">&#9888; Actions</span> }
                                    else { <span style="color:var(--muted)">—</span> }
                                </td>
                                <td>@r.SubmittedAt.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                <td class="history-actions-cell">
                                    <div class="history-actions">
                                        <a asp-page="/AuditResult" asp-route-id="@r.Id" class="dl-link">View</a>
                                        @if (!r.IsLegacy)
                                        {
                                            <a asp-page="/Audit" asp-route-id="@r.Id" class="dl-link">Edit</a>
                                            <a href="/api/audits/hod/@r.Id/pdf" class="dl-link pdf-dl" data-filename="HoD_@(r.Date.ToString("yyyyMMdd")).pdf">PDF</a>
                                        }
                                        else
                                        {
                                            <a href="/api/submissions/@r.Id/pdf" class="dl-link pdf-dl" data-filename="TLSW_@(r.Date.ToString("yyyyMMdd")).pdf">PDF</a>
                                        }
                                        @if (Model.IsAdmin)
                                        {
                                            <form method="post" asp-page-handler="Delete" class="history-delete-form"
                                                  onsubmit="return confirm('Delete this audit record? This cannot be undone.');">
                                                <input type="hidden" name="from" value="@Model.From" />
                                                <input type="hidden" name="to" value="@Model.To" />
                                                <input type="hidden" name="area" value="@Model.AreaFilter" />
                                                <input type="hidden" name="q" value="@Model.PersonFilter" />
                                                <input type="hidden" name="id" value="@r.Id" />
                                                <input type="hidden" name="isLegacy" value="@(r.IsLegacy ? "true" : "false")" />
                                                <button type="submit" class="dl-link dl-delete">Delete</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
