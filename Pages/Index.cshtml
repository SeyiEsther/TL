@page
@model IndexModel
@inject TL.Services.PersonListService PersonList
@{
    ViewData["Title"] = "Home";
}

<div class="welcome-wrap">
    <div class="welcome-card">
        <div class="welcome-name">Welcome@(Model.UserName != null ? ", " + Model.UserName : "")</div>
        <div class="welcome-time">@DateTime.Now.ToString("dddd d MMMM yyyy")</div>

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="sf-row">
                <div class="fl">
                    <label>Date</label>
                    <input type="date" name="ShiftDate" value="@Model.ShiftDate" required>
                </div>
                <div class="fl">
                    <label>Shift</label>
                    <select name="Shift" required>
                        <option value="">Select shift…</option>
                        <option value="Day" selected="@(Model.Shift == "Day" ? "selected" : null)">Day</option>
                        <option value="Afternoon" selected="@(Model.Shift == "Afternoon" ? "selected" : null)">Afternoon</option>
                        <option value="Night" selected="@(Model.Shift == "Night" ? "selected" : null)">Night</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom:14px">
                <partial name="_TeamLeaderPicker" model='new FilterDropdownModel("TeamLeader", "Team leader", Model.TeamLeader, "Select your name…")' />
            </div>

            <div id="coveringPanel" style="display:none;margin-bottom:14px;padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:10px">
                <div class="fl" style="margin-bottom:10px">
                    <label>Your name <span style="color:var(--red)">*</span></label>
                    <input type="text" name="OtherName" value="@(Model.OtherName ?? "")" placeholder="Who is filling this in" autocomplete="name">
                </div>
                <div class="fl">
                    <label>Covering for <span style="color:var(--muted);font-weight:400;text-transform:none">(optional)</span></label>
                    <select name="CoveringFor">
                        <option value="">— Not covering for anyone —</option>
                        @foreach (var name in PersonList.TeamLeaders)
                        {
                            <option value="@name" selected="@(Model.CoveringFor == name ? "selected" : null)">@name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="fl" style="margin-bottom:6px">
                <label>Area <span style="color:var(--red)">*</span></label>
                <select name="Area" required>
                    <option value="">Select area…</option>
                    @foreach (var grp in AreaList.All.GroupBy(a => a.Group))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var area in grp)
                            {
                                var display = string.IsNullOrEmpty(area.Machines)
                                    ? area.Label
                                    : $"{area.Label} ({area.Machines})";
                                <option value="@area.Label" selected="@(Model.Area == area.Label ? "selected" : null)">@display</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="err">@Model.Error</div>
            }

            <button type="submit" class="welcome-btn primary">Start hourly check &rarr;</button>
        </form>
    </div>
</div>

<script>
(function () {
    var picker = document.getElementById('fs-TeamLeader');
    var panel = document.getElementById('coveringPanel');
    if (!picker || !panel) return;
    var hidden = picker.querySelector('.fs-input');
    function sync() { panel.style.display = (hidden && hidden.value === '__other__') ? 'block' : 'none'; }
    document.addEventListener('click', function () { setTimeout(sync, 0); });
    sync();
})();
</script>
