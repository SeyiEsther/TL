@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="welcome-wrap">
    <div class="welcome-card">
        <div class="welcome-name">Welcome@(Model.UserName != null ? ", " + Model.UserName : "")</div>
        <div class="welcome-time">@DateTime.Now.ToString("dddd d MMMM yyyy")</div>

        @if (Model.InProgressShifts.Count > 0)
        {
            <div class="in-progress-panel">
                <div class="in-progress-title">Continue where you left off</div>
                <p class="in-progress-hint">Saved shifts for today — pick one to resume your hourly checks.</p>
                <div class="in-progress-list">
                    @foreach (var s in Model.InProgressShifts)
                    {
                        var hoursSaved = s.Hours?.Count ?? 0;
                        <a class="in-progress-item" asp-page="/Form" asp-route-id="@s.Id" asp-route-tl="@s.TeamLeaderDisplay">
                            <span class="in-progress-area">@s.Area</span>
                            <span class="in-progress-meta">@s.Shift shift · @s.TeamLeaderDisplay</span>
                            @if (hoursSaved > 0)
                            {
                                <span class="in-progress-badge">@hoursSaved hr@(hoursSaved == 1 ? "" : "s") saved</span>
                            }
                            else
                            {
                                <span class="in-progress-badge muted">Started</span>
                            }
                        </a>
                    }
                </div>
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()

            <div class="sf-row">
                <div class="fl">
                    <label>Date</label>
                    <input type="date" name="ShiftDate" value="@Model.ShiftDate" required>
                </div>
                <div class="fl">
                    <label>Shift</label>
                    <select name="Shift" required>
                        <option value="">Select shift…</option>
                        <option value="Day" selected="@(Model.Shift == "Day" ? "selected" : null)">Day</option>
                        <option value="Afternoon" selected="@(Model.Shift == "Afternoon" ? "selected" : null)">Afternoon</option>
                        <option value="Night" selected="@(Model.Shift == "Night" ? "selected" : null)">Night</option>
                    </select>
                </div>
            </div>

            <div class="fl" style="margin-bottom:14px">
                <label>Team leader</label>
                <input type="text" name="TeamLeader" value="@Model.TeamLeader" placeholder="Enter your full name" required>
            </div>

            <div class="fl" style="margin-bottom:6px">
                <label>Area <span style="color:var(--red)">*</span></label>
                <select name="Area" required>
                    <option value="">Select area…</option>
                    @foreach (var grp in AreaList.All.GroupBy(a => a.Group))
                    {
                        <optgroup label="@grp.Key">
                            @foreach (var area in grp)
                            {
                                var display = string.IsNullOrEmpty(area.Machines)
                                    ? area.Label
                                    : $"{area.Label} ({area.Machines})";
                                <option value="@area.Label" selected="@(Model.Area == area.Label ? "selected" : null)">@display</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="err">@Model.Error</div>
            }

            <button type="submit" class="welcome-btn primary">Start hourly check &rarr;</button>
        </form>
    </div>
</div>
