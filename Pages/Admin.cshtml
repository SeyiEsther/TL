@page
@model AdminModel
@{ ViewData["Title"] = "Admin"; }

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Admin</div>
            <div class="page-sub">In-progress shifts and name lists</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="card" style="margin-bottom:14px;padding:12px 16px;font-size:13px;color:#16a34a;background:#f0fdf4;border-color:#bbf7d0">
            @Model.StatusMessage
        </div>
    }

    <div class="card" style="margin-bottom:14px">
        <div class="card-head">
            <span class="card-title">Name lists</span>
            <span class="card-sub">Separate pages for each picker</span>
        </div>
        <div style="padding:16px 18px;display:flex;flex-wrap:wrap;gap:10px">
            <a asp-page="/AdminActions" class="sbtn sm primary">All actions (PDCA)</a>
            <a asp-page="/AdminFullAccess" class="sbtn sm primary">Full access users</a>
            <a asp-page="/AdminTeamLeaders" class="sbtn sm">Team leaders</a>
            <a asp-page="/AdminHodNames" class="sbtn sm">HoD names</a>
            <a asp-page="/AdminShiftManagers" class="sbtn sm">Shift manager names</a>
            <a asp-page="/AdminSeniorNames" class="sbtn sm">Senior names</a>
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="card-head">
            <span class="card-title">Production targets</span>
            <span class="card-sub">Pull through read-only wherever targets are shown</span>
        </div>
        <div style="overflow-x:auto">
            <table class="dash-table" style="min-width:640px">
                <thead>
                    <tr>
                        <th>Target</th>
                        <th>Value</th>
                        <th>Last changed</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Targets)
                    {
                        <tr>
                            <td style="font-weight:600">@t.Label</td>
                            <td colspan="2">
                                <form method="post" asp-page-handler="UpdateTarget"
                                      style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                                    <input type="hidden" name="key" value="@t.Key" />
                                    <input type="number" name="value" value="@t.Value" min="0" step="1"
                                           class="ff-input" style="max-width:120px" required />
                                    <button type="submit" class="sbtn sm primary">Save</button>
                                    <span style="font-size:12px;color:var(--muted)">
                                        @if (t.UpdatedAt.HasValue)
                                        {
                                            <text>@(t.UpdatedBy ?? "—") &bull; @t.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</text>
                                        }
                                        else { <text>Default value</text> }
                                    </span>
                                </form>
                            </td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="card-head">
            <span class="card-title">Daily Report targets</span>
            <span class="card-sub">Shift managers see these read-only on the Daily Report</span>
        </div>
        <div style="overflow-x:auto">
            <table class="dash-table" style="min-width:680px">
                <thead>
                    <tr>
                        <th>Section</th>
                        <th>Measure</th>
                        <th>Target</th>
                        <th>Last changed</th>
                    </tr>
                </thead>
                <tbody>
                    @{ string? rtSection = null; }
                    @foreach (var t in Model.ReportTargets)
                    {
                        <tr>
                            <td style="font-weight:600;color:var(--muted)">@(t.Section == rtSection ? "" : t.Section)</td>
                            <td>@t.Label</td>
                            <td colspan="2">
                                <form method="post" asp-page-handler="UpdateReportTarget"
                                      style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                                    <input type="hidden" name="section" value="@t.Section" />
                                    <input type="hidden" name="label" value="@t.Label" />
                                    <input type="text" name="value" value="@t.Target" placeholder="e.g. 0, 90 or 95%"
                                           class="ff-input" style="max-width:140px" />
                                    <button type="submit" class="sbtn sm primary">Save</button>
                                    <span style="font-size:12px;color:var(--muted)">
                                        @if (t.UpdatedAt.HasValue)
                                        {
                                            <text>@(t.UpdatedBy ?? "—") &bull; @t.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</text>
                                        }
                                        else { <text>Not set</text> }
                                    </span>
                                </form>
                            </td>
                        </tr>
                        rtSection = t.Section;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="card-head">
            <span class="card-title">Document numbers</span>
            <span class="card-sub">Printed in each PDF footer</span>
        </div>
        <div style="overflow-x:auto">
            <table class="dash-table" style="min-width:560px">
                <thead>
                    <tr>
                        <th>Form</th>
                        <th>Document number</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DocumentNumbers)
                    {
                        <tr>
                            <td style="font-weight:600">@d.Label</td>
                            <td colspan="2">
                                <form method="post" asp-page-handler="UpdateDocNumber"
                                      style="display:flex;gap:8px;align-items:center">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <input type="text" name="number" value="@d.Number" placeholder="e.g. CI038/01/1123/CW"
                                           class="ff-input" style="max-width:260px" />
                                    <button type="submit" class="sbtn sm primary">Save</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <span class="card-title">In-progress shifts</span>
            <span class="card-sub">@Model.InProgressShifts.Count open session@(Model.InProgressShifts.Count == 1 ? "" : "s")</span>
        </div>
        @if (!Model.InProgressShifts.Any())
        {
            <div class="empty">No in-progress shifts.</div>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="dash-table" style="min-width:900px">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Shift</th>
                            <th>Area</th>
                            <th>Person</th>
                            <th>Hours</th>
                            <th>Last activity</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.InProgressShifts)
                        {
                            <tr>
                                <td>@s.Date.ToString("dd/MM/yyyy")</td>
                                <td>@s.Shift</td>
                                <td style="font-weight:600">@s.Area</td>
                                <td>@AdminModel.PersonLabel(s.TeamLeader, s.CoveringFor)</td>
                                <td>@s.HoursFilled / @s.HoursTotal</td>
                                <td>@s.LastActivity.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                <td class="history-actions-cell">
                                    <div class="history-actions">
                                        <a asp-page="/Form" asp-route-id="@s.Id" class="dl-link">Open</a>
                                        <form method="post" asp-page-handler="DeleteSession" class="history-delete-form"
                                              onsubmit="return confirm('Delete this in-progress shift? This cannot be undone.');">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="dl-link dl-delete">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
