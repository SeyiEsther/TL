@page
@model AdminModel
@using TL.Models
@{ ViewData["Title"] = "Admin";
   var tabs = new[] { "sessions", "teamleaders", "hod" }; }

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Admin</div>
            <div class="page-sub">Manage in-progress shifts and picker names</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="card" style="margin-bottom:14px;padding:12px 16px;font-size:13px;color:#16a34a;background:#f0fdf4;border-color:#bbf7d0">
            @Model.StatusMessage
        </div>
    }
    @if (Model.Error == "duplicate")
    {
        <div class="card" style="margin-bottom:14px;padding:12px 16px;font-size:13px;color:#b45309;background:#fffbeb;border-color:#fde68a">
            That name is already on the list.
        </div>
    }

    @if (Model.PeopleReadOnly && Model.Tab is "teamleaders" or "hod")
    {
        <div class="card" style="margin-bottom:14px;padding:12px 16px;font-size:13px;color:#b45309;background:#fffbeb;border-color:#fde68a">
            Name list database is not ready yet. Showing built-in defaults — restart the app after deploy so migrations run, or ask IT to apply the PickerPersons migration.
        </div>
    }

    <div class="sd-tab-bar card" style="margin-bottom:14px;padding:8px 12px">
        @foreach (var t in tabs)
        {
            <a asp-page="/Admin" asp-route-tab="@t" class="sd-tab @(Model.Tab == t ? "active" : "")" style="text-decoration:none">@Model.TabLabel(t)</a>
        }
    </div>

    @if (Model.Tab == "sessions")
    {
        <div class="card">
            <div class="card-head">
                <span class="card-title">In-progress shifts</span>
                <span class="card-sub">@Model.InProgressShifts.Count open session@(Model.InProgressShifts.Count == 1 ? "" : "s")</span>
            </div>
            @if (!Model.InProgressShifts.Any())
            {
                <div class="empty">No in-progress shifts.</div>
            }
            else
            {
                <div style="overflow-x:auto">
                    <table class="dash-table" style="min-width:900px">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Shift</th>
                                <th>Area</th>
                                <th>Person</th>
                                <th>Hours</th>
                                <th>Last activity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.InProgressShifts)
                            {
                                <tr>
                                    <td>@s.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@s.Shift</td>
                                    <td style="font-weight:600">@s.Area</td>
                                    <td>@AdminModel.PersonLabel(s.TeamLeader, s.CoveringFor)</td>
                                    <td>@s.HoursFilled / @s.HoursTotal</td>
                                    <td>@s.LastActivity.ToLocalTime().ToString("dd MMM HH:mm")</td>
                                    <td class="history-actions-cell">
                                        <div class="history-actions">
                                            <a asp-page="/Form" asp-route-id="@s.Id" class="dl-link">Open</a>
                                            <form method="post" asp-page-handler="DeleteSession" class="history-delete-form"
                                                  onsubmit="return confirm('Delete this in-progress shift? This cannot be undone.');">
                                                <input type="hidden" name="id" value="@s.Id" />
                                                <button type="submit" class="dl-link dl-delete">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        var isHod = Model.Tab == "hod";
        var listKind = isHod ? PersonListKinds.Hod : PersonListKinds.TeamLeader;
        var people = isHod ? Model.HodPeople : Model.TeamLeaderPeople;
        var title = isHod ? "HoD / Shift Mgr names" : "Team leader names";
        <div class="card" style="margin-bottom:14px">
            <div class="card-head">
                <span class="card-title">@title</span>
                <span class="card-sub">@people.Count name@(people.Count == 1 ? "" : "s")</span>
            </div>
            <form method="post" asp-page-handler="AddPerson" style="padding:16px 18px;border-bottom:1px solid var(--border);display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
                <input type="hidden" name="listKind" value="@listKind" />
                <input type="hidden" name="tab" value="@Model.Tab" />
                <div class="fl" style="margin:0;flex:1;min-width:220px">
                    <label>Add name</label>
                    <input type="text" name="name" placeholder="Full name…" required autocomplete="off" style="width:100%" @(Model.PeopleReadOnly ? "disabled" : null)>
                </div>
                <button type="submit" class="sbtn primary sm" @(Model.PeopleReadOnly ? "disabled" : null)>Add</button>
            </form>
            @if (!people.Any())
            {
                <div class="empty">No names yet.</div>
            }
            else
            {
                <div style="overflow-x:auto">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in people)
                            {
                                <tr>
                                    <td style="font-weight:600">@p.Name</td>
                                    <td class="history-actions-cell">
                                        @if (!Model.PeopleReadOnly)
                                        {
                                        <form method="post" asp-page-handler="RemovePerson" class="history-delete-form"
                                              onsubmit="return confirm('Remove @p.Name from the list?');">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="tab" value="@Model.Tab" />
                                            <button type="submit" class="dl-link dl-delete">Remove</button>
                                        </form>
                                        }
                                        else
                                        {
                                            <span style="font-size:11px;color:var(--muted)">Read-only</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <p style="font-size:12px;color:var(--muted);max-width:720px">
            Names appear in the Home team leader picker and HoD audit start screen. Changes take effect immediately — no redeploy needed.
        </p>
    }
</div>
