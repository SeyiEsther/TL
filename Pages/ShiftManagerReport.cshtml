@page
@model ShiftManagerReportModel
@using TL.Models
@{
    ViewData["Title"] = "Shift Manager Daily Report";
    var hseHeads = new Dictionary<int, string> { [0] = "Safety", [5] = "Process & quality", [8] = "Absence", [14] = "People" };
}

<style>
    .smr-body { padding: 14px 16px; }
    .smr-metrics { width:100%; border-collapse:collapse; }
    .smr-metrics thead th { text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:.06em;
        color:var(--muted); font-weight:700; padding:2px 16px 10px; }
    .smr-metrics thead th.num { text-align:center; width:130px; }
    .smr-metrics td { padding:6px 16px; border-top:1px solid var(--border); }
    .smr-metrics td.num { text-align:center; }
    .smr-metrics td.label { font-size:13px; color:var(--ink); }
    .smr-sub td { background:var(--surface); font-size:10px; text-transform:uppercase; letter-spacing:.07em;
        color:#6b7280; font-weight:800; padding:8px 16px; border-top:1px solid var(--border); }
    .smr-num { width:104px; padding:8px 10px; border:1px solid var(--border); border-radius:9px; font-size:13px;
        text-align:center; font-family:inherit; color:var(--ink); background:var(--white);
        box-shadow:0 1px 2px rgba(15,17,23,.03); }
    .smr-num:focus { outline:none; border-color:var(--red); box-shadow:0 0 0 3px rgba(204,31,44,.10); }
    .smr-note { padding:14px 16px; border-top:1px solid var(--border); }
    .smr-note label { display:block; font-size:10px; text-transform:uppercase; letter-spacing:.06em;
        color:var(--muted); font-weight:700; margin-bottom:6px; }
    .smr-audit-row { display:grid; grid-template-columns:1fr auto auto; gap:12px 16px; align-items:center;
        padding:12px 16px; }
    .smr-audit-row + .smr-audit-row { border-top:1px solid var(--border); }
    .smr-audit-row .a-type { font-size:14px; font-weight:700; color:var(--ink); }
    .smr-audit-row .a-day { font-size:12px; color:var(--muted); }
    .smr-help { font-size:12px; color:var(--muted); padding:0 2px 12px; }
</style>

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Shift Manager Daily Report</div>
            <div class="page-sub">Daily HSE, production and audit summary</div>
        </div>
        <a asp-page="/ShiftManager" class="sbtn sm">&larr; Shift Manager</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="err" style="margin-bottom:14px">@Model.Error</div>
    }

    <form method="post" data-backup="sm-report" data-backup-key="@(Model.EditingId?.ToString() ?? "new")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="EditingId" value="@(Model.EditingId?.ToString() ?? "")" />

        <!-- Report details -->
        <div class="audit-card">
            <div class="audit-head final"><div class="audit-acc"></div><span>Report details</span></div>
            <div class="smr-body" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px">
                <div class="ff" style="margin:0"><span class="ff-label">Date</span><div class="ff-control">
                    <input type="date" name="ReportDate" class="ff-input" value="@Model.ReportDate" required></div></div>
                <div class="ff" style="margin:0"><span class="ff-label">Shift</span><div class="ff-control">
                    <select name="Shift" class="ff-select" required>
                        <option value="">Select…</option>
                        @foreach (var s in ShiftReportDefs.Shifts)
                        {
                            <option value="@s" selected="@(Model.Shift == s ? "selected" : null)">@s</option>
                        }
                    </select></div></div>
                <div class="ff" style="margin:0"><span class="ff-label">Manager</span><div class="ff-control">
                    <input type="text" name="ManagerName" class="ff-input" list="sm-managers"
                           value="@Model.ManagerName" placeholder="Name…" required>
                    <datalist id="sm-managers">@foreach (var m in Model.Managers) { <option value="@m"></option> }</datalist>
                </div></div>
            </div>
        </div>

        <!-- HSE -->
        <div class="audit-card">
            <div class="audit-head safety"><div class="audit-acc"></div><span>HSE — target vs actual</span></div>
            <div style="overflow-x:auto">
                <table class="smr-metrics">
                    <thead><tr><th>Measure</th><th class="num">Target</th><th class="num">Actual</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.HseRows.Count; i++)
                        {
                            @if (hseHeads.TryGetValue(i, out var head))
                            {
                                <tr class="smr-sub"><td colspan="3">@head</td></tr>
                            }
                            <tr>
                                <td class="label">@Model.HseRows[i].Label</td>
                                <td class="num"><input type="text" inputmode="numeric" name="HseTarget[@i]" class="smr-num" value="@Model.HseRows[i].Target"></td>
                                <td class="num"><input type="text" name="HseActual[@i]" class="smr-num" value="@Model.HseRows[i].Actual"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="smr-note">
                <label>Manager / HSE comments &amp; actions</label>
                <textarea name="ManagerHseComments" class="audit-ta">@Model.ManagerHseComments</textarea>
            </div>
        </div>

        <!-- Production -->
        <div class="audit-card">
            <div class="audit-head quality"><div class="audit-acc"></div><span>Production — target vs actual</span></div>
            <div style="overflow-x:auto">
                <table class="smr-metrics">
                    <thead><tr><th>Line</th><th class="num">Target</th><th class="num">Actual</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.ProductionRows.Count; i++)
                        {
                            <tr>
                                <td class="label">@Model.ProductionRows[i].Label</td>
                                <td class="num"><input type="text" inputmode="numeric" name="ProdTarget[@i]" class="smr-num" value="@Model.ProductionRows[i].Target"></td>
                                <td class="num"><input type="text" name="ProdActual[@i]" class="smr-num" value="@Model.ProductionRows[i].Actual"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="smr-note">
                <label>Production comments &amp; actions</label>
                <textarea name="ProductionComments" class="audit-ta">@Model.ProductionComments</textarea>
            </div>
        </div>

        <!-- Audits completed -->
        <div class="audit-card">
            <div class="audit-head perf"><div class="audit-acc"></div><span>Audits completed</span></div>
            @for (int i = 0; i < Model.Audits.Count; i++)
            {
                <div class="smr-audit-row">
                    <div><span class="a-type">@Model.Audits[i].Type</span></div>
                    <div class="a-day">@Model.Audits[i].Day</div>
                    <select name="AuditDone[@i]" class="ff-select" style="min-width:96px">
                        <option value="">—</option>
                        <option value="Y" selected="@(Model.Audits[i].Completed == "Y" ? "selected" : null)">Yes</option>
                        <option value="N" selected="@(Model.Audits[i].Completed == "N" ? "selected" : null)">No</option>
                    </select>
                </div>
            }
        </div>

        <!-- LSW & AOB -->
        <div class="audit-card">
            <div class="audit-head morale"><div class="audit-acc"></div><span>LSW &amp; AOB comments</span></div>
            <div class="smr-note" style="border-top:0">
                <label>LSW — Team Leaders</label>
                <textarea name="LswTeamLeaderComments" class="audit-ta">@Model.LswTeamLeaderComments</textarea>
            </div>
            <div class="smr-note">
                <label>LSW — HoD</label>
                <textarea name="LswHodComments" class="audit-ta">@Model.LswHodComments</textarea>
            </div>
            <div class="smr-note">
                <label>AOB</label>
                <textarea name="Aob" class="audit-ta">@Model.Aob</textarea>
            </div>
        </div>

        <div class="audit-footer">
            <button type="submit" class="sbtn primary">Save report</button>
            <a asp-page="/ShiftManager" class="sbtn">Cancel</a>
        </div>
    </form>
</div>
