@page
@model ShiftManagerReportModel
@using TL.Models
@{
    ViewData["Title"] = "Shift Manager Daily Report";
}

<style>
    .smr-metrics { width:100%; border-collapse:collapse; min-width:720px; }
    .smr-metrics thead th { text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:.06em;
        color:var(--muted); font-weight:700; padding:8px 12px; background:var(--surface); border-bottom:1px solid var(--border); }
    .smr-metrics thead th.num { text-align:center; width:96px; }
    .smr-metrics thead th.prog { text-align:center; width:96px; }
    .smr-metrics td { padding:6px 12px; border-top:1px solid var(--border); vertical-align:middle; }
    .smr-metrics td.num { text-align:center; }
    .smr-metrics td.label { font-size:13px; color:var(--ink); font-weight:600; white-space:nowrap; }
    .smr-num { width:80px; padding:7px 8px; border:1px solid var(--border); border-radius:8px; font-size:13px;
        text-align:center; font-family:inherit; color:var(--ink); background:var(--white);
        box-shadow:0 1px 2px rgba(15,17,23,.03); }
    .smr-num:focus, .smr-comm:focus, .smr-prog:focus { outline:none; border-color:var(--red); box-shadow:0 0 0 3px rgba(204,31,44,.10); }
    .smr-comm { width:100%; min-width:180px; padding:7px 10px; border:1px solid var(--border); border-radius:8px;
        font-size:13px; font-family:inherit; color:var(--ink); background:var(--white); }
    .smr-prog { width:82px; padding:7px 6px; border:1px solid var(--border); border-radius:8px; font-size:13px;
        font-family:inherit; color:var(--ink); background:var(--white); text-align:center; }
    .smr-target { display:inline-block; min-width:56px; padding:6px 8px; font-size:13px; font-weight:700;
        color:var(--ink); background:var(--surface); border:1px solid var(--border); border-radius:8px; }
    .smr-audit-row { display:grid; grid-template-columns:1fr auto auto; gap:12px 16px; align-items:center;
        padding:12px 16px; }
    .smr-audit-row + .smr-audit-row { border-top:1px solid var(--border); }
    .smr-audit-row .a-type { font-size:14px; font-weight:700; color:var(--ink); }
    .smr-audit-row .a-day { font-size:12px; color:var(--muted); }
    .smr-note { padding:14px 16px; border-top:1px solid var(--border); }
    .smr-note label { display:block; font-size:10px; text-transform:uppercase; letter-spacing:.06em;
        color:var(--muted); font-weight:700; margin-bottom:6px; }
    @@media print {
        .smr-num, .smr-comm, .smr-prog { border:1px solid #999; box-shadow:none; }
    }
</style>

@{
    // Renders one spreadsheet-style metric section: Target | Actual |
    // Comments/Actions | Progress(O/C). Morale passes showTarget:false.
    async Task MetricSection(string title, string headClass, string prefix,
        List<ShiftMetricRow> rows, bool showTarget)
    {
        await Task.CompletedTask;
        <div class="audit-card">
            <div class="audit-head @headClass"><div class="audit-acc"></div><span>@title</span></div>
            <div style="overflow-x:auto">
                <table class="smr-metrics">
                    <thead>
                        <tr>
                            <th>@title</th>
                            @if (showTarget) { <th class="num">Target<span style="font-weight:400;text-transform:none"> (admin)</span></th> }
                            <th class="num">Actual</th>
                            <th>Comments / Actions</th>
                            <th class="prog">Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < rows.Count; i++)
                        {
                            <tr>
                                <td class="label">@rows[i].Label</td>
                                @if (showTarget)
                                {
                                    <td class="num"><span class="smr-target" title="Set by admin">@(string.IsNullOrWhiteSpace(rows[i].Target) ? "—" : rows[i].Target)</span></td>
                                }
                                <td class="num"><input type="text" name="@(prefix)Actual[@i]" class="smr-num" value="@rows[i].Actual"></td>
                                <td><input type="text" name="@(prefix)Comments[@i]" class="smr-comm" value="@rows[i].Comments"></td>
                                <td class="num">
                                    <select name="@(prefix)Progress[@i]" class="smr-prog">
                                        <option value="">—</option>
                                        <option value="O" selected="@(rows[i].Progress == "O" ? "selected" : null)">O</option>
                                        <option value="C" selected="@(rows[i].Progress == "C" ? "selected" : null)">C</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<div class="dwrap">
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Shift Manager Daily Report</div>
            <div class="page-sub">Daily HSE, production and audit summary</div>
        </div>
        <a asp-page="/ShiftManager" class="sbtn sm">&larr; Shift Manager</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="err" style="margin-bottom:14px">@Model.Error</div>
    }

    <form method="post" data-backup="sm-report" data-backup-key="@(Model.EditingId?.ToString() ?? "new")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="EditingId" value="@(Model.EditingId?.ToString() ?? "")" />

        <!-- Report details -->
        <div class="audit-card">
            <div class="audit-head final"><div class="audit-acc"></div><span>Report details</span></div>
            <div class="smr-body" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px">
                <div class="ff" style="margin:0"><span class="ff-label">Date</span><div class="ff-control">
                    <input type="date" name="ReportDate" class="ff-input" value="@Model.ReportDate" required></div></div>
                <div class="ff" style="margin:0"><span class="ff-label">Shift</span><div class="ff-control">
                    <select name="Shift" class="ff-select" required>
                        <option value="">Select…</option>
                        @foreach (var s in ShiftReportDefs.Shifts)
                        {
                            <option value="@s" selected="@(Model.Shift == s ? "selected" : null)">@s</option>
                        }
                    </select></div></div>
                <div class="ff" style="margin:0"><span class="ff-label">Manager</span><div class="ff-control">
                    <input type="text" name="ManagerName" class="ff-input" list="sm-managers"
                           value="@Model.ManagerName" placeholder="Name…" required>
                    <datalist id="sm-managers">@foreach (var m in Model.Managers) { <option value="@m"></option> }</datalist>
                </div></div>
            </div>
        </div>

        @* Four spreadsheet sections, each Target | Actual | Comments/Actions |
           Progress(O/C). Morale is a single count + comment (no target). *@
        @{ await MetricSection("HSE", "safety", "Hse", Model.HseRows, true); }
        @{ await MetricSection("Quality", "quality", "Qual", Model.QualityRows, true); }
        @{ await MetricSection("Morale", "morale", "Morale", Model.MoraleRows, false); }
        @{ await MetricSection("Production", "perf", "Prod", Model.ProductionRows, true); }

        @* Legacy section comment fields, now captured per-row above. Round-tripped
           hidden so any previously-saved text is preserved on edit. *@
        <input type="hidden" name="ManagerHseComments" value="@Model.ManagerHseComments" />
        <input type="hidden" name="ProductionComments" value="@Model.ProductionComments" />

        <!-- Audits completed -->
        <div class="audit-card">
            <div class="audit-head perf"><div class="audit-acc"></div><span>Audits completed</span></div>
            @for (int i = 0; i < Model.Audits.Count; i++)
            {
                <div class="smr-audit-row">
                    <div><span class="a-type">@Model.Audits[i].Type</span></div>
                    <div class="a-day">@Model.Audits[i].Day</div>
                    <select name="AuditDone[@i]" class="ff-select" style="min-width:96px">
                        <option value="">—</option>
                        <option value="Y" selected="@(Model.Audits[i].Completed == "Y" ? "selected" : null)">Yes</option>
                        <option value="N" selected="@(Model.Audits[i].Completed == "N" ? "selected" : null)">No</option>
                    </select>
                </div>
            }
        </div>

        <!-- LSW & AOB -->
        <div class="audit-card">
            <div class="audit-head morale"><div class="audit-acc"></div><span>LSW &amp; AOB comments</span></div>
            <div class="smr-note" style="border-top:0">
                <label>LSW — Team Leaders</label>
                <textarea name="LswTeamLeaderComments" class="audit-ta">@Model.LswTeamLeaderComments</textarea>
            </div>
            <div class="smr-note">
                <label>LSW — HoD</label>
                <textarea name="LswHodComments" class="audit-ta">@Model.LswHodComments</textarea>
            </div>
            <div class="smr-note">
                <label>AOB</label>
                <textarea name="Aob" class="audit-ta">@Model.Aob</textarea>
            </div>
        </div>

        <div class="audit-footer">
            <button type="submit" class="sbtn primary">Save report</button>
            <a asp-page="/ShiftManager" class="sbtn">Cancel</a>
        </div>
    </form>
</div>
