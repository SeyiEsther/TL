@page
@model SeniorSuccessModel
@{ ViewData["Title"] = "Audit Submitted"; }

<div class="welcome-wrap">
    <div class="welcome-card" style="max-width:480px;text-align:center">
        <div style="width:48px;height:48px;background:#16a34a;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <div class="welcome-name" style="font-size:18px">Senior audit submitted</div>
        <div class="welcome-time" style="margin-bottom:20px">
            @Model.Area &bull; @Model.AuditDate &bull; @Model.AuditorName
        </div>
        <a asp-page="/SeniorStart" class="welcome-btn primary">New audit</a>
        <a asp-page="/Index" class="welcome-btn secondary">Home</a>
    </div>
</div>
