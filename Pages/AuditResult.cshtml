@page
@model AuditResultModel
@using TL.Models
@using TL.Services
@{ ViewData["Title"] = "Audit result"; }

<div class="dwrap">
@if (Model.IsHodDaily && Model.HodAudit != null)
{
    var a = Model.HodAudit;
    var sections = Model.Answers.GroupBy(x => x.Section).ToList();
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">@HodAuditTypes.LabelFor(a.AuditType)</div>
            <div class="page-sub">@a.AuditDate.ToString("dd/MM/yyyy") &bull; Area to audit: <strong>@a.Department</strong> &bull; Effectiveness check: <strong>@a.ResolveEffectivenessArea()</strong></div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a asp-page="/AuditResult" asp-route-id="@a.Id" class="sbtn sm">View</a>
            <a asp-page="/Audit" asp-route-id="@a.Id" class="sbtn sm">Edit</a>
            <a href="/api/audits/hod/@a.Id/pdf" class="sbtn primary sm pdf-dl" data-filename="HoD_@(a.AuditDate.ToString("yyyyMMdd"))_@(a.ResolveEffectivenessArea().Replace(" ", "_")).pdf">&#8595; PDF</a>
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="meta-row">
            <div class="meta-item"><span class="meta-label">Auditor</span><span class="meta-val">@a.AuditorName</span></div>
            <div class="meta-item"><span class="meta-label">Submitted</span><span class="meta-val">@a.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span></div>
            <div class="meta-item"><span class="meta-label">Score</span><span class="meta-val" style="font-weight:800;color:@HodAuditScoring.BandColor(a.TotalScore, a.MaxScore)">@a.TotalScore / @a.MaxScore</span></div>
            <div class="meta-item"><span class="meta-label">Rating</span><span class="meta-val">@Model.RatingBand</span></div>
            <div class="meta-item"><span class="meta-label">Auditor signed</span><span class="meta-val">@(a.AuditorSignature ?? "—")</span></div>
            <div class="meta-item"><span class="meta-label">TL signed</span><span class="meta-val">@(a.TeamLeaderSignature ?? "—")</span></div>
        </div>
        @if (!string.IsNullOrEmpty(Model.RatingDetail))
        {
            <div style="padding:10px 18px 14px;font-size:12px;color:var(--muted);border-top:1px solid var(--border)">@Model.RatingDetail</div>
        }
    </div>

    @foreach (var sec in sections)
    {
        <div class="card" style="margin-bottom:14px">
            <div class="card-head"><span class="card-title">@sec.Key</span></div>
            <table class="dash-table">
                <thead><tr><th>Question</th><th>Score</th><th>Evidence</th></tr></thead>
                <tbody>
                    @foreach (var q in sec)
                    {
                        <tr>
                            <td>@q.Label</td>
                            <td><span class="rag @(q.Pass == true ? "g" : q.Pass == false ? "r" : "u")">@AuditResultModel.PassFail(q.Pass)</span></td>
                            <td style="font-size:12px;color:var(--muted)">@(string.IsNullOrWhiteSpace(q.Evidence) ? "—" : q.Evidence)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.Effectiveness.Count > 0)
    {
        <div class="card" style="margin-bottom:14px">
            <div class="card-head"><span class="card-title">Effectiveness check</span></div>
            <div style="overflow-x:auto">
                <table class="dash-table" style="min-width:820px">
                    <thead>
                        <tr><th>TL</th><th>Shift</th><th>Date</th><th>Form</th><th>Sign-off</th><th>Close status</th><th>Notes</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Effectiveness)
                        {
                            var rowStyle = f.IsAuditFinding || f.TlClaimMismatch ? "background:#fef2f2" : null;
                            <tr style="@rowStyle">
                                <td>@(string.IsNullOrEmpty(f.TeamLeader) ? "—" : f.TeamLeader)</td>
                                <td>@(f.Shift ?? "—")</td>
                                <td>@(f.ShiftDate == default ? "—" : f.ShiftDate.ToString("dd/MM"))</td>
                                <td>
                                    @if (string.IsNullOrEmpty(f.TeamLeader))
                                    {
                                        <span class="rag r">No forms</span>
                                    }
                                    else if (f.FormComplete)
                                    {
                                        <span class="rag g">Complete</span>
                                    }
                                    else
                                    {
                                        <span class="rag r">@f.HoursComplete/@f.HoursTotal hrs</span>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(f.TeamLeader)) { <span>—</span> }
                                    else if (f.OutgoingSignedOff) { <span class="rag g">Signed</span> }
                                    else { <span class="rag r">Unsigned</span> }
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(f.TeamLeader))
                                    {
                                        <span class="rag r">@f.CloseStatus</span>
                                    }
                                    else
                                    {
                                        var closeCls = f.CloseStatus == "Closed correctly" ? "g" : "r";
                                        <span class="rag @closeCls">@f.CloseStatus</span>
                                    }
                                </td>
                                <td style="font-size:11px">
                                    @string.Join(" · ", f.Issues)
                                    @if (f.TlClaimMismatch && f.LinkedAuditFailures.Count > 0)
                                    {
                                        <div style="color:#b91c1c;margin-top:4px">Mismatch: @string.Join("; ", f.LinkedAuditFailures)</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card" style="margin-bottom:14px">
        <div class="card-head"><span class="card-title">Findings &amp; actions</span></div>
        <div style="padding:16px 18px;display:flex;flex-direction:column;gap:12px;font-size:13px">
            @if (!string.IsNullOrWhiteSpace(a.ActionsRaised))
            {
                <div><div style="font-size:10px;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:4px">Actions raised</div>@a.ActionsRaised</div>
            }
            @if (!string.IsNullOrWhiteSpace(a.GoodPractice))
            {
                <div><div style="font-size:10px;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:4px">Good practice</div>@a.GoodPractice</div>
            }
            @if (string.IsNullOrWhiteSpace(a.ActionsRaised) && string.IsNullOrWhiteSpace(a.GoodPractice))
            {
                <div style="color:var(--muted)">No findings recorded.</div>
            }
        </div>
    </div>
}
else if (Model.Audit != null)
{
    var h = Model.Check;
    var a = Model.Audit;
    <div class="page-head" style="margin-bottom:14px">
        <div>
            <div class="page-title" style="font-size:18px;font-weight:700">Head of Department / Shift Manager (legacy)</div>
            <div class="page-sub">Audit result &bull; @a.ShiftDate.ToString("dd/MM/yyyy") &bull; <strong>@a.Area</strong></div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a href="/api/submissions/@a.Id/pdf" class="sbtn primary sm pdf-dl" data-filename="Audit_@(a.ShiftDate.ToString("yyyyMMdd")).pdf">&#8595; PDF</a>
        </div>
    </div>

    <div class="card" style="margin-bottom:14px">
        <div class="meta-row">
            <div class="meta-item"><span class="meta-label">Auditor</span><span class="meta-val">@a.TeamLeaderDisplay</span></div>
            <div class="meta-item"><span class="meta-label">Submitted</span><span class="meta-val">@a.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span></div>
            <div class="meta-item"><span class="meta-label">Signed</span><span class="meta-val">@(a.OutgoingTLSignature ?? "—")</span></div>
            @if (h != null)
            {
                <div class="meta-item"><span class="meta-label">Safety</span><span class="rv @AuditResultModel.Rc(h.OverallSafetyStatus)">@(h.OverallSafetyStatus ?? "—")</span></div>
                <div class="meta-item"><span class="meta-label">Quality</span><span class="rv @AuditResultModel.Rc(h.OverallQualityStatus)">@(h.OverallQualityStatus ?? "—")</span></div>
                <div class="meta-item"><span class="meta-label">Performance</span><span class="rv @AuditResultModel.Rc(h.OverallPerfStatus)">@(h.OverallPerfStatus ?? "—")</span></div>
            }
        </div>
    </div>

    @if (h != null)
    {
        <div class="card" style="margin-bottom:14px">
            <div class="card-head"><span class="card-title">Summary</span></div>
            <div class="meta-row">
                <div class="meta-item"><span class="meta-label">6S completed</span><span class="meta-val">@AuditResultModel.Bn(h.SixSCompleted)</span></div>
                <div class="meta-item"><span class="meta-label">TPM completed</span><span class="meta-val">@AuditResultModel.Bn(h.TPMCompleted)</span></div>
                <div class="meta-item"><span class="meta-label">Parts ID'd</span><span class="meta-val">@AuditResultModel.Bn(h.PartsIdCorrect)</span></div>
                <div class="meta-item"><span class="meta-label">NC stored correctly</span><span class="meta-val">@AuditResultModel.Bn(h.NCPartsStoredCorrectly)</span></div>
            </div>
        </div>
    }

    <div class="card" style="margin-bottom:14px">
        <div class="card-head"><span class="card-title">Findings &amp; actions</span></div>
        <div style="padding:16px 18px;display:flex;flex-direction:column;gap:12px;font-size:13px">
            @if (!string.IsNullOrWhiteSpace(a.Escalations))
            {
                <div><div style="font-size:10px;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:4px">Actions raised</div>@a.Escalations</div>
            }
            @if (!string.IsNullOrWhiteSpace(a.KeyRisks))
            {
                <div><div style="font-size:10px;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:4px">Good practice observed</div>@a.KeyRisks</div>
            }
            @if (!string.IsNullOrWhiteSpace(a.Priorities))
            {
                <div><div style="font-size:10px;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:4px">Follow-up required</div>@a.Priorities</div>
            }
            @if (string.IsNullOrWhiteSpace(a.Escalations) && string.IsNullOrWhiteSpace(a.KeyRisks) && string.IsNullOrWhiteSpace(a.Priorities))
            {
                <div style="color:var(--muted)">No findings recorded.</div>
            }
        </div>
    </div>
}

    <a asp-page="/HodHistory" class="sbtn">&larr; Back to history</a>
</div>
