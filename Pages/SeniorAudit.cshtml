@page
@model SeniorAuditModel
@using TL.Services
@{ ViewData["Title"] = "Senior Team Audit";
   var auditDateDisplay = DateOnly.TryParse(Model.AuditDate, out var ad) ? ad.ToString("dd/MM/yyyy") : Model.AuditDate; }

<div class="audit-wrap" data-audit-form>

    <div class="audit-sticky">
        <div class="audit-sticky-top">
            <div>
                <div class="audit-sticky-title">Senior Team Weekly Audit</div>
                <div class="audit-sticky-sub">
                    @auditDateDisplay &bull; <strong>@Model.Area</strong>
                    @if (!string.IsNullOrEmpty(Model.AuditorName)) { <span> &bull; @Model.AuditorName</span> }
                </div>
            </div>
            @if (Model.EditingId.HasValue) { <span class="audit-badge-editing">Editing</span> }
            @if (Model.EditingId.HasValue)
            {
                <a href="/api/audits/@Model.EditingId/pdf" class="sbtn sm pdf-dl" data-filename="Senior_Audit.pdf" style="margin-left:auto">&#8595; PDF</a>
            }
            <div class="audit-progress-meta">
                <div class="audit-progress-track"><div class="audit-progress-fill"></div></div>
                <span class="audit-progress-text">0/0</span>
            </div>
        </div>
        <nav class="audit-sec-nav" aria-label="Audit sections">
            <a href="#sec-leadership" class="audit-sec-link">Leadership</a>
            <a href="#sec-safety" class="audit-sec-link">Safety</a>
            <a href="#sec-quality" class="audit-sec-link">Quality</a>
            <a href="#sec-people" class="audit-sec-link">People</a>
            <a href="#sec-standards" class="audit-sec-link">Standards</a>
            <a href="#sec-performance" class="audit-sec-link">Performance</a>
            <a href="#sec-findings" class="audit-sec-link">Findings</a>
        </nav>
    </div>

    <div style="background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px 16px;margin-bottom:14px;font-size:12px;color:#1e40af;line-height:1.5">
        <strong>Scoring:</strong> Each question uses a 0–2 scale —
        <strong>0</strong> not met, <strong>1</strong> partial, <strong>2</strong> fully met.
        Two auditors should score the same way.
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="err" style="margin-bottom:14px">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="auditDate" value="@Model.AuditDate">
        <input type="hidden" name="auditorName" value="@Model.AuditorName">
        <input type="hidden" name="area" value="@Model.Area">
        @if (Model.EditingId.HasValue) { <input type="hidden" name="editingId" value="@Model.EditingId"> }

        <div class="audit-card" id="sec-leadership">
            <div class="audit-head" style="background:#1e3a5f"><div class="audit-acc"></div><span>Leadership &amp; Governance</span></div>
            <div class="audit-body">
                @{ await RenderScore("Shift handover standards being followed?",
                    "A.HandoverStandardsFollowed", Model.A.HandoverStandardsFollowed,
                    "Outgoing TL has briefed incoming TL; checklist completed and signed"); }
                @{ await RenderScore("RPS boards up to date?",
                    "A.VisualManagementCurrent", Model.A.VisualManagementCurrent,
                    "RPS boards are current, owned and reflect the area's priorities"); }
                @{ await RenderScore("Escalation paths being used correctly?",
                    "A.EscalationPathsUsed", Model.A.EscalationPathsUsed,
                    "Issues are being surfaced through the right channels at the right level"); }
                @{ await RenderNote("Notes", "A.GovernanceNotes", Model.A.GovernanceNotes); }
            </div>
        </div>

        <div class="audit-card" id="sec-safety">
            <div class="audit-head safety"><div class="audit-acc"></div><span>Safety Culture</span></div>
            <div class="audit-body">
                @{ await RenderScore("PPE compliance 100% across the area?",
                    "A.PpeComplianceFull", Model.A.PpeComplianceFull,
                    "All team members wearing correct PPE — no exceptions observed"); }
                @{ await RenderScore("Near-misses being reported and acted on?",
                    "A.NearMissesReported", Model.A.NearMissesReported,
                    "Near-miss log is current; corrective actions have owners and due dates"); }
                @{ await RenderNote("Notes &amp; observations", "A.SafetyNotes", Model.A.SafetyNotes); }
            </div>
        </div>

        <div class="audit-card" id="sec-quality">
            <div class="audit-head quality"><div class="audit-acc"></div><span>Quality Governance</span></div>
            <div class="audit-body">
                @{ await RenderScore("First-off inspection records complete?",
                    "A.FirstOffRecordsComplete", Model.A.FirstOffRecordsComplete,
                    "First-off checks have been signed off and filed for all jobs run this week"); }
                @{ await RenderScore("Non-conformance procedure followed?",
                    "A.NcProcedureFollowed", Model.A.NcProcedureFollowed,
                    "NC process is being followed — capture, containment, and escalation as required"); }
                @{ await RenderScore("Quality gates maintained across the process?",
                    "A.QualityGatesMaintained", Model.A.QualityGatesMaintained,
                    "Inspection points and hold points are staffed and not being bypassed"); }
                @{ await RenderNote("Notes &amp; observations", "A.QualityNotes", Model.A.QualityNotes); }
            </div>
        </div>

        <div class="audit-card" id="sec-people">
            <div class="audit-head morale"><div class="audit-acc"></div><span>People &amp; Wellbeing</span></div>
            <div class="audit-body">
                @{ await RenderScore("Operator check — visibility of leaders?",
                    "A.LeaderVisibilityCheck", Model.A.LeaderVisibilityCheck,
                    "How often do operators see their leadership team on the floor?"); }
                @{ await RenderText("When was the last team meeting?",
                    "A.LastTeamMeeting", Model.A.LastTeamMeeting,
                    "Date or how long ago — e.g. &quot;Tue 1 Jul&quot; or &quot;2 weeks ago&quot;"); }
                @{ await RenderScore("Training matrix current and actioned?",
                    "A.TrainingMatrixCurrent", Model.A.TrainingMatrixCurrent,
                    "Training plans are up to date, gaps identified and in progress"); }
                @{ await RenderNote("Notes &amp; observations", "A.PeopleNotes", Model.A.PeopleNotes); }
            </div>
        </div>

        <div class="audit-card" id="sec-standards">
            <div class="audit-head" style="background:#6d28d9"><div class="audit-acc"></div><span>Standards &amp; Housekeeping</span></div>
            <div class="audit-body">
                @{ await RenderScore("6S standard maintained across the area?",
                    "A.SixSStandardMaintained", Model.A.SixSStandardMaintained,
                    "Audit score consistent with previous week; no regression in any zone"); }
                @{ await RenderScore("TPM schedule being followed?",
                    "A.TpmScheduleFollowed", Model.A.TpmScheduleFollowed,
                    "All planned preventive maintenance tasks completed on schedule this week"); }
                @{ await RenderScore("Standard work maintained across the area?",
                    "A.StandardWorkMaintained", Model.A.StandardWorkMaintained,
                    "Standard work is defined, followed and consistent across the area"); }
                @{ await RenderNote("Notes &amp; observations", "A.StandardsNotes", Model.A.StandardsNotes); }
            </div>
        </div>

        <div class="audit-card" id="sec-performance">
            <div class="audit-head perf"><div class="audit-acc"></div><span>Performance</span></div>
            <div class="audit-body">
                @{ await RenderScore("Area tracking against weekly production plan?",
                    "A.TrackingAgainstWeeklyPlan", Model.A.TrackingAgainstWeeklyPlan,
                    "Output is on or ahead of the weekly plan; any shortfall has a recovery plan"); }
                @{ await RenderScore("Improvement actions progressing?",
                    "A.ImprovementActionsProgressing", Model.A.ImprovementActionsProgressing,
                    "CI actions from last audit have moved forward; no stalled items without reason"); }
                @{ await RenderNote("Notes &amp; actions taken", "A.PerformanceNotes", Model.A.PerformanceNotes); }
            </div>
        </div>

        <div class="audit-card audit-findings-card" id="sec-findings" style="margin-top:16px">
            <div class="card-head"><span class="card-title">Audit findings &amp; actions</span></div>
            <div class="audit-findings-body">

                <div class="fl">
                    <label>Good practice observed</label>
                    <textarea name="A.GoodPracticeObserved" rows="3" placeholder="What was working well and should be recognised or shared…">@Model.A.GoodPracticeObserved</textarea>
                </div>

                <div class="fl">
                    <label>Areas for improvement</label>
                    <textarea name="A.AreasForImprovement" rows="3" placeholder="What needs to improve before the next audit…">@Model.A.AreasForImprovement</textarea>
                </div>

                <div class="fl">
                    <label>Actions raised</label>
                    <textarea name="A.ActionsRaised" rows="4" placeholder="Specific actions, owner and due date for each…">@Model.A.ActionsRaised</textarea>
                </div>

                <div class="fl">
                    <label>Overall audit verdict</label>
                    <div class="verdict-pills" style="margin-top:6px">
                        @foreach (var v in new[] { "Green", "Amber", "Red" })
                        {
                            var vid = $"verdict_{v.ToLower()}";
                            <input type="radio" name="A.OverallVerdict" id="@vid" value="@v" checked="@(Model.A.OverallVerdict == v ? "checked" : null)">
                            <label for="@vid" class="verdict-pill">@v</label>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="audit-sign-card">
            <div class="audit-sign-title">Sign-off</div>
            <div class="fl" style="max-width:360px">
                <label>Auditor signature</label>
                <input type="text" name="auditorSignature" value="@Model.AuditorSignature" placeholder="Type your full name to sign">
            </div>
            <div class="audit-sign-hint">By signing, you confirm this audit record is accurate and complete.</div>
        </div>

        <div class="audit-footer">
            <button type="submit" class="welcome-btn primary">Submit audit &rarr;</button>
            <a asp-page="/SeniorStart" class="welcome-btn secondary">Cancel</a>
        </div>
    </form>
</div>

@functions {
    async Task RenderScore(string label, string field, byte? val, string? hint = null)
    {
        var gid = field.Replace(".", "_");
        <div class="audit-q">
            <div class="audit-q-label">
                <span>@Html.Raw(label)</span>
                @if (hint != null)
                {
                    <span class="q-hint">@hint</span>
                }
            </div>
            <div class="audit-yn score-3">
                @foreach (var opt in new[] { (0, "0", "Not met"), (1, "1", "Partial"), (2, "2", "Met") })
                {
                    var id = $"{gid}_{opt.Item1}";
                    <input type="radio" name="@field" id="@id" value="@opt.Item1" checked="@(val == opt.Item1 ? "checked" : null)">
                    <label for="@id" title="@opt.Item3">@opt.Item2</label>
                }
            </div>
        </div>
        await Task.CompletedTask;
    }

    async Task RenderText(string label, string field, string? val, string? hint = null)
    {
        <div class="audit-q">
            <div class="audit-q-label">
                <span>@Html.Raw(label)</span>
                @if (hint != null)
                {
                    <span class="q-hint">@Html.Raw(hint)</span>
                }
            </div>
            <input type="text" name="@field" value="@val" class="audit-ta" style="min-height:auto;padding:10px 12px"
                   placeholder="Enter date or timeframe…" autocomplete="off">
        </div>
        await Task.CompletedTask;
    }

    async Task RenderNote(string label, string field, string? val)
    {
        <div class="audit-note">
            <label class="audit-note-lbl">@Html.Raw(label)</label>
            <textarea name="@field" class="audit-ta" placeholder="Detail any findings…">@val</textarea>
        </div>
        await Task.CompletedTask;
    }
}
